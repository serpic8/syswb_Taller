@model syswb_Taller.Models.DetallePagoOrden
@using System.Security.Claims

@{
    ViewBag.Title = "Detalle de Pago";
    // Fecha/hora de impresión
    string fechaHora = DateTime.Now.ToString("dd/MM/yyyy HH:mm");
    // Número de factura igual que en tu view de creación
    var numeroFactura = "FAC-" + Model.IdOrden.ToString("D4") + "-" + DateTime.Now.Year;
    // Nombre de empleado desde Claims
    var givenName = User.FindFirstValue(ClaimTypes.GivenName)  ?? string.Empty;
    var surname   = User.FindFirstValue(ClaimTypes.Surname)    ?? string.Empty;
    string empleadoNombre = string.IsNullOrEmpty(givenName) && string.IsNullOrEmpty(surname)
        ? "Empleado no identificado"
        : $"{givenName} {surname}";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

@section Header { }
@section Footer { }

<div class="container animate__animated animate__fadeIn" style="max-width: 700px;">
  <div class="invoice-header d-flex justify-content-between align-items-center mb-4 p-3 rounded-top shadow-sm" style="background: linear-gradient(135deg, #0d6efd, #6610f2); color: #fff;">
    <h4 class="mb-0"><i class="bi bi-receipt-cutoff me-2"></i>@ViewBag.Title</h4>
    <span class="fs-6 fw-semibold">@fechaHora</span>
  </div>

  <div class="invoice-body border rounded-bottom p-4 shadow-sm bg-white">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
      <h4 class="mb-0">Pago de Orden #@Model.IdOrden</h4>
      <div class="text-end">
        <label class="form-label mb-1 small text-muted">Factura No.</label>
        <div class="fw-bold fs-5">@numeroFactura</div>
      </div>
    </div>

    @if (TempData.ContainsKey("Error"))
    {
      <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>
        <div>@TempData["Error"]</div>
      </div>
    }

    <dl class="row mb-4 fs-5">
      <dt class="col-sm-4 fw-semibold text-secondary">Monto Pagado</dt>
      <dd class="col-sm-8 text-success fw-bold fs-4">@Model.MontoPagado.ToString("C")</dd>

      <dt class="col-sm-4 fw-semibold text-secondary">Método de Pago</dt>
      <dd class="col-sm-8">@Model.MetodoPago</dd>

      <dt class="col-sm-4 fw-semibold text-secondary">Observaciones</dt>
      <dd class="col-sm-8">@Html.DisplayFor(m => m.Observaciones)</dd>

      <dt class="col-sm-4 fw-semibold text-secondary">Registrado por</dt>
      <dd class="col-sm-8">@empleadoNombre</dd>

      <dt class="col-sm-4 fw-semibold text-secondary">Fecha de Registro</dt>
      <dd class="col-sm-8">@Model.FechaPago.ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>

    <div class="text-end">
      <button type="button" class="btn btn-primary me-2" onclick="window.print();">
        <i class="bi bi-printer me-1"></i> Imprimir
      </button>
      <a asp-action="Editar" asp-controller="Orden" asp-route-id="@Model.IdOrden" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left-circle me-1"></i> Volver
      </a>
    </div>
  </div>
</div>

@section Styles {
  <style>
    /* Estilos para impresión */
    @@media print {
      .btn, a.btn {
        display: none !important;
      }
      body {
        background-color: white !important;
      }
      .invoice-body {
        box-shadow: none !important;
        border: none !important;
        padding: 0 !important;
      }
    }
  </style>
}
