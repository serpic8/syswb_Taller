@using System.Linq
@model List<dynamic>
@{
    ViewBag.Title = "Seleccionar Cliente y Vehículo";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h3 class="card-title text-center mb-4">Seleccionar Cliente para Orden</h3>

                    <form method="get" class="row g-3 mb-4">
                        <div class="col-md-8">
                            <input  
                                name="nombre" 
                                class="form-control" 
                                placeholder="Buscar por nombre" 
                                value="@(ViewBag.FiltroNombre ?? "")" />
                        </div>
                        <div class="col-md-3">
                            <select name="activo" class="form-select">
                                <option value="">-- Todos --</option>
                                <!option value="true" @(ViewBag.FiltroActivo == true ? "selected" : "")>Activos</!option>
                                <!option value="false" @(ViewBag.FiltroActivo == false ? "selected" : "")>Inactivos</!option>
                            </select>
                        </div>
                        <div class="col-md-1 d-grid">
                            <button class="btn btn-primary">Filtrar</button>
                        </div>
                    </form>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light text-center">
                                <tr>
                                    <th>Cliente</th>
                                    <th>Teléfono</th>
                                    <th>Vehículos</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model)
                                {
                                    // obtenemos la lista de vehículos y el primero para el doble clic
                                    var vehs = (c.Vehiculos as IEnumerable<dynamic>) ?? Enumerable.Empty<dynamic>();
                                    var primerVehiculoID = vehs.FirstOrDefault()?.IdVehiculo;
                                <tr style="cursor:pointer;"
                                    ondblclick="location.href='@Url.Action("Crear","Orden",
                                        new { clienteID = c.Id, vehiculoID = primerVehiculoID })'">
                                    <td>
                                        <strong>@c.Nombre @c.Apellido</strong>
                                    </td>
                                    <td class="text-center">
                                        @c.Telefono
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm">
                                            <option disabled selected>Seleccione...</option>
                                            @foreach (var v in vehs)
                                            {
                                                <option value="@v.IdVehiculo">
                                                    @v.VhMatricula – @v.VhMarca
                                                </option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
