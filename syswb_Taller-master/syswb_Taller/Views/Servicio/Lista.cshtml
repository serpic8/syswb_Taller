@model List<syswb_Taller.Models.Servicio>
@using System.Globalization
@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"
@{
    ViewData["Title"] = "Servicios";
    var servicios = Model;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />

@section Header { }
@section Footer { }

<style>
    .filter-bar {
        background: #fff;
        padding: 1rem;
        border-radius: .5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }

        .filter-bar .btn-group a.active {
            background-color: #0097cc;
            color: #fff;
            border-color: #0097cc;
        }

    .table-card {
        border-radius: .5rem;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    }

        .table-card .card-header {
            background: #0097cc;
            color: #fff;
            font-weight: 600;
        }

        .table-card tbody tr:hover {
            background: rgba(0,151,204,0.1);
            cursor: pointer;
        }
</style>

<div class="d-flex justify-content-end mb-3">
    <a asp-controller="Menu" asp-action="Menu"
       class="btn btn-outline-primary btn-lg shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-house-door-fill fs-5"></i>
        <span>Menú Principal</span>
    </a>
</div>

<div class="filter-bar row align-items-center">
    <div class="col-md-6">
        <h2 class="mb-0"><i class="bi bi-gear-fill me-2"></i>Servicios</h2>
    </div>
    <div class="col-md-6 d-flex justify-content-end">
        <input type="text" id="dtSearch" class="form-control form-control-sm me-3" style="max-width:200px;"
               placeholder="Buscar servicio..." />
        <div class="btn-group">
            <a asp-action="Lista" class="btn btn-sm btn-outline-secondary">Todas</a>
            <a asp-action="Lista" asp-route-activo="true" class="btn btn-sm btn-outline-secondary">Activas</a>
            <a asp-action="Lista" asp-route-activo="false" class="btn btn-sm btn-outline-secondary">Inactivas</a>
        </div>
    </div>
</div>

<div class="table-card">
    <div class="card-header">
        <i class="bi bi-gear-fill me-2"></i> Lista de Servicios
        <a asp-action="Crear" class="btn btn-sm btn-success float-end">
            <i class="bi bi-plus-circle-fill me-1"></i> Nuevo
        </a>
    </div>
    <div class="card-body p-0">
        <table id="serviciosTable" class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th><i class="bi bi-hash me-1"></i>ID</th>
                    <th><i class="bi bi-card-text me-1"></i>Nombre</th>
                    <th class="text-end"><i class="bi bi-currency-dollar me-1"></i>Precio Unitario</th>
                    <th class="text-center"><i class="bi bi-check-circle me-1"></i>Activo</th>
                </tr>
            </thead>
            <tbody>
                @if (servicios.Any())
                {
                    foreach (var s in servicios)
                    {
                        <tr ondblclick="window.location='@Url.Action("Editar", "Servicio", new { id = s.IdServicio })'">
                            <td>@s.IdServicio</td>
                            <td>@s.SerNombre</td>
                            <td class="text-end">@s.SerPrecioUnit.ToString("C", CultureInfo.CurrentCulture)</td>
                            <td class="text-center align-middle" onclick="event.stopPropagation();">
                                <form asp-action="CambiarEstado" method="post" class="d-inline-block" onsubmit="event.stopPropagation();">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idServicio" value="@s.IdServicio" />
                                    <button type="submit" class="btn btn-sm d-flex justify-content-center align-items-center @(s.SerActivo ? "text-success" : "text-danger")" style="width:32px;height:32px;" title="Alternar estado">
                                        <i class="bi @(s.SerActivo ? "bi-check-lg" : "bi-x-lg")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-4">
                            <i class="bi bi-exclamation-circle me-2"></i>No se encontraron servicios.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            var table = $('#serviciosTable').DataTable({
                dom: 'lrtip',         // quita buscador interno
                lengthChange: false,
                pageLength: 20,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Buscar...",
                    paginate: { previous: "Anterior", next: "Siguiente" }
                },
                order: [[0, 'asc']],
                columnDefs: [{ orderable: true, targets: '_all' }]
            });

            // conectar buscador externo
            $('#dtSearch').on('input', function () {
                table.search(this.value).draw();
            });
        });
    </script>
}
