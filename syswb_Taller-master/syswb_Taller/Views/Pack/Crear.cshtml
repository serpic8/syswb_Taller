@model dynamic
@using System.Globalization
@{
    ViewBag.Title = "Crear Pack de Reparación";
    var pack = ViewBag.Pack;
    var productos = ViewBag.Productos as List<syswb_Taller.Models.ProductoRepuesto> ?? new();
    var servicios = ViewBag.Servicios as List<syswb_Taller.Models.Servicio> ?? new();
    var detalles = ViewBag.Detalles as List<dynamic> ?? new List<dynamic>();
    double costo = ViewBag.CostoTotal != null ? (double)ViewBag.CostoTotal : 0.0;
    var niCulture = new CultureInfo("es-NI");
    bool esEdicion = pack != null && pack.IdPack != 0;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        .select2-container .select2-selection--single {
            height: 38px;
            padding: 6px 12px;
            font-size: 1rem;
        }
    </style>
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white d-flex align-items-center">
            <i class="bi bi-tools fs-3 me-2"></i>
            <h2 class="mb-0">@ViewBag.Title</h2>
        </div>
        <div class="card-body">
            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-4">
                    <label class="form-label fw-semibold">Nombre del Pack</label>
                    <input name="pckNombre" class="form-control form-control-lg" required />
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold">Descripción (opcional)</label>
                    <textarea name="pckDescripcion" class="form-control" rows="3"></textarea>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success btn-lg flex-grow-1">
                        <i class="bi bi-check-circle me-2"></i> Crear Pack
                    </button>
                    <a asp-action="Lista" class="btn btn-outline-secondary btn-lg flex-grow-1">
                        <i class="bi bi-x-circle me-2"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            $('.select2').select2({
                width: '100%',
                placeholder: function () {
                    return $(this).data('placeholder');
                },
                tags: false
            });
        });
    </script>
}
