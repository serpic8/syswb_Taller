@{
    ViewBag.Title = "Menú Principal";
    var usuario = User.Identity.IsAuthenticated ? User.Identity.Name : "Invitado";
    var cajaAbierta = ViewBag.CajaAbierta as bool? ?? false;
}

@section Header { }
@section Footer { }

<!-- Asegúrate de tener esto en tu _Layout o en la cabecera de la página -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<style>
    body {
        margin: 0;
        background: linear-gradient(300deg, #0097cc, #071b7c);
        font-family: 'Segoe UI', sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .top-bar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        backdrop-filter: blur(10px);
        background: rgba(0,0,0,0.3);
        color: #fff;
        padding: 1rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 1000;
    }

        .top-bar h1 {
            margin: 0;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .top-bar .btn {
            margin-left: 1rem;
            font-weight: 600;
            font-size: .9rem;
        }

    .main-content {
        flex: 1;
        margin: 5rem 2rem 5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .button-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(180px,1fr));
        gap: 1.5rem;
        width: 100%;
        max-width: 1100px;
    }

        .button-grid a {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
            border-radius: 1rem;
            color: #fff;
            font-size: 1.25rem;
            font-weight: 600;
            text-decoration: none;
            box-shadow: 0 6px 16px rgba(0,0,0,0.2);
            transition: transform .2s,box-shadow .2s;
        }

            .button-grid a:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 28px rgba(0,0,0,0.3);
            }

        .button-grid i {
            font-size: 2rem;
            margin-bottom: .4rem;
        }

    .btn-orden {
        background: #007bff;
    }

    .btn-presupuesto {
        background: #28a745;
    }

    .btn-packs {
        background: #17a2b8;
    }

    .btn-productos {
        background: #6c757d;
    }

    .btn-clientes {
        background: #343a40;
    }

    .btn-vehiculos {
        background: #ffc107;
        color: #333;
    }

    .btn-servicios {
        background: #dc3545;
    }

    .btn-admin {
        background: #e3770a;
        color: #333;
    }

    .create-btn {
        background: rgba(255,255,255,0.2);
        border: 2px solid #fff;
        color: #fff;
        font-weight: 600;
        padding: .8rem 1.5rem;
        border-radius: 50px;
        font-size: 1rem;
        transition: background .3s;
    }

        .create-btn:hover {
            background: rgba(255,255,255,0.4);
        }

    .bottom-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        backdrop-filter: blur(10px);
        background: rgba(0,0,0,0.3);
        color: #fff;
        padding: 1rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 500;
        z-index: 1000;
        font-size: .95rem;
    }

    .clock {
        font-family: 'Courier New', monospace;
    }
</style>

<!-- Top Bar -->
<div class="top-bar">
    <div>
        @if (!cajaAbierta)
        {
            <form asp-controller="CajaDiaria" asp-action="AbrirCaja" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-warning fw-bold">
                    <i class="bi bi-box-arrow-in-down me-1"></i>Abrir Caja
                </button>
            </form>
        }
        else
        {
            <form asp-controller="CajaDiaria" asp-action="CerrarCaja" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger fw-bold">
                    <i class="bi bi-box-arrow-up-left me-1"></i>Cerrar Caja
                </button>
            </form>
        }

        <form asp-controller="Menu" asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-light fw-bold">
                <i class="bi bi-door-closed me-1"></i>Logout
            </button>
        </form>
    </div>
    <h1>@ViewBag.Title</h1>
</div>

<!-- Main Content -->
<div class="main-content">
    <div class="text-center mb-4">
        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#chooseTypeModal">
            <i class="bi bi-plus-lg me-1"></i>Crear
        </button>
    </div>
    <div class="button-grid">
        <a class="btn-orden" asp-action="Orden" asp-controller="Menu">
            <i class="bi bi-card-list"></i>Orden
        </a>
        <a class="btn-presupuesto" asp-action="Presupuesto" asp-controller="Menu">
            <i class="bi bi-receipt"></i>Presupuesto
        </a>
        <a class="btn-packs" asp-action="Packs" asp-controller="Menu">
            <i class="bi bi-boxes"></i>Packs
        </a>
        <a class="btn-productos" asp-action="Productos" asp-controller="Menu">
            <i class="bi bi-bag-check"></i>Productos
        </a>
        <a class="btn-clientes" asp-action="Clientes" asp-controller="Menu">
            <i class="bi bi-people-fill"></i>Clientes
        </a>
        <a class="btn-vehiculos" asp-action="Vehiculos" asp-controller="Menu">
            <i class="bi bi-truck"></i>Vehículos
        </a>
        <a class="btn-servicios" asp-action="Servicios" asp-controller="Menu">
            <i class="bi bi-wrench"></i>Servicios
        </a>
        @if (User.IsInRole("Administrador") || User.IsInRole("Supervisor"))
        {
            <a class="btn-admin" asp-action="Administracion" asp-controller="Menu">
                <i class="bi bi-gear-fill"></i>Admin
            </a>
        }
        else if (User.IsInRole("Cajero"))
        {
            <a class="btn-admin" asp-action="CajaDiaria" asp-controller="Menu">
                <i class="bi bi-cash-stack"></i>Admin
            </a>
        }
    </div>
</div>


<!-- Bottom Bar -->
<div class="bottom-bar">
    <div><i class="bi bi-person-circle me-1"></i>@usuario</div>
    <div class="clock"><i class="bi bi-clock me-1"></i><span id="liveClock"></span></div>
</div>




<!-- Paso 1: elegir Tipo -->
<div class="modal fade" id="chooseTypeModal" tabindex="-1" aria-labelledby="chooseTypeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="chooseTypeModalLabel">¿Qué deseas crear?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center">
                <p>Selecciona una opción:</p>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-primary" id="btnCreateOrder">
                        <i class="bi bi-card-list me-1"></i> Crear Orden
                    </button>
                    <button type="button" class="btn btn-success" id="btnCreatePresupuesto">
                        <i class="bi bi-receipt me-1"></i> Crear Presupuesto
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Paso 2a: elegir cliente para Orden -->
<div class="modal fade" id="chooseClientOrderModal" tabindex="-1" aria-labelledby="chooseClientOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="chooseClientOrderModalLabel">Crear Orden</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center">
                <p>¿Cómo deseas continuar?</p>
                <div class="d-grid gap-2">
                    <a asp-controller="Cliente" asp-action="Crear" asp-route-redirigirA="Orden" class="btn btn-outline-primary">
                        <i class="bi bi-person-plus me-1"></i> Nuevo Cliente
                    </a>
                    <a asp-controller="Orden" asp-action="SeleccionarClienteOrden" class="btn btn-outline-secondary">
                        <i class="bi bi-people me-1"></i> Seleccionar Cliente
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Paso 2b: elegir cliente para Presupuesto -->
<div class="modal fade" id="chooseClientPresModal" tabindex="-1" aria-labelledby="chooseClientPresModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="chooseClientPresModalLabel">Crear Presupuesto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center">
                <p>¿Cómo deseas continuar?</p>
                <div class="d-grid gap-2">
                    <a asp-controller="Cliente" asp-action="Crear" asp-route-redirigirA="Presupuesto" class="btn btn-outline-primary">
                        <i class="bi bi-person-plus me-1"></i> Nuevo Cliente
                    </a>
                    <a asp-controller="Presupuesto" asp-action="SeleccionarClientePresupuesto" class="btn btn-outline-secondary">
                        <i class="bi bi-people me-1"></i> Seleccionar Cliente
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        function updateClock() {
            const now = new Date();
            const opts = {
                day: '2-digit', month: '2-digit', year: 'numeric',
                hour: '2-digit', minute: '2-digit', second: '2-digit'
            };
            document.getElementById('liveClock').textContent =
                now.toLocaleString('es-NI', opts);
        }
        setInterval(updateClock, 1000);
        updateClock();

        const chooseTypeModalEl = document.getElementById('chooseTypeModal');
        const chooseTypeModal = new bootstrap.Modal(chooseTypeModalEl);
        const orderModal = new bootstrap.Modal(document.getElementById('chooseClientOrderModal'));
        const presModal = new bootstrap.Modal(document.getElementById('chooseClientPresModal'));

        // Flujos
        document.getElementById('btnCreateOrder').addEventListener('click', () => {
            chooseTypeModal.hide();
            orderModal.show();
        });
        document.getElementById('btnCreatePresupuesto').addEventListener('click', () => {
            chooseTypeModal.hide();
            presModal.show();
        });

        // Reiniciar flujo al cerrar cualquier modal secundario
        ['chooseClientOrderModal', 'chooseClientPresModal'].forEach(id => {
            document.getElementById(id).addEventListener('hidden.bs.modal', () => {
                // si quieres volver al primer modal:
                // chooseTypeModal.show();
            });
        });
    </script>
}
