@model dynamic
@using syswb_Taller.Models

@{
    ViewBag.Title = "Registro de Empleado";
    var roles = ViewBag.Roles as List<Roles> ?? new List<Roles>();
}

@section Header { }
@section Footer { }

@section Styles {
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/intl-tel-input@17.0.19/build/css/intlTelInput.min.css" />
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i>Registrar Nuevo Empleado</h2>
        </div>
        <div class="card-body">
            <form asp-action="Nuevo" method="post" id="empleadoForm" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label for="pNombre" class="form-label fw-semibold">
                        <i class="bi bi-person-fill me-1"></i>Nombre
                    </label>
                    <input type="text"
                           id="pNombre"
                           name="pNombre"
                           class="form-control form-control-lg"
                           placeholder="Ej: Juan"
                           required />
                    <div class="invalid-feedback">
                        El nombre es obligatorio.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="pApellido" class="form-label fw-semibold">
                        <i class="bi bi-person-fill me-1"></i>Apellido
                    </label>
                    <input type="text"
                           id="pApellido"
                           name="pApellido"
                           class="form-control form-control-lg"
                           placeholder="Ej: Pérez"
                           required />
                    <div class="invalid-feedback">
                        El apellido es obligatorio.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="pTelefono" class="form-label fw-semibold">
                        <i class="bi bi-telephone-fill me-1"></i>Teléfono
                    </label>
                    <input type="tel"
                           id="pTelefono"
                           class="form-control form-control-lg"
                           placeholder="Ingrese el número"
                           required />
                    <input type="hidden" name="pTelefono" id="telefonoFormateado" />
                    <div class="form-text text-danger mt-2 d-none" id="telefonoError" role="alert" aria-live="assertive">
                        Número inválido.
                    </div>
                    <div class="invalid-feedback">
                        El teléfono es obligatorio.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="pCedula" class="form-label fw-semibold">
                        <i class="bi bi-credit-card-2-front-fill me-1"></i>Cédula
                    </label>
                    <input type="text"
                           id="pCedula"
                           name="pCedula"
                           class="form-control form-control-lg"
                           placeholder="001-221204-1029Q"
                           pattern="^\d{3}-\d{6}-[A-Z0-9]{5}$"
                           required
                           oninput="formatCedula(this)" />
                    <div class="invalid-feedback">
                        Formato: 001-221204-1029Q (último caracter en mayúscula).
                    </div>
                </div>

                <div class="mb-4">
                    <label for="empUsuario" class="form-label fw-semibold">
                        <i class="bi bi-person-badge-fill me-1"></i>Usuario
                    </label>
                    <input type="text"
                           id="empUsuario"
                           name="empUsuario"
                           class="form-control form-control-lg"
                           required />
                    <div class="invalid-feedback">
                        El usuario es obligatorio.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="contrasena_texto" class="form-label fw-semibold">
                        <i class="bi bi-key-fill me-1"></i>Contraseña
                    </label>
                    <input type="password"
                           id="contrasena_texto"
                           name="contrasena_texto"
                           class="form-control form-control-lg"
                           pattern="(?=.*[A-Z])(?=.*\W).{8,}"
                           title="Mínimo 8 caracteres, al menos una mayúscula y un símbolo especial"
                           required />
                    <div class="invalid-feedback" id="passwordError">
                        Debe tener al menos 8 caracteres, una mayúscula y un símbolo especial.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="confirm_contrasena" class="form-label fw-semibold">
                        <i class="bi bi-key-fill me-1"></i>Confirmar Contraseña
                    </label>
                    <input type="password"
                           id="confirm_contrasena"
                           class="form-control form-control-lg"
                           required />
                    <div class="invalid-feedback" id="confirmError">
                        Las contraseñas no coinciden.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="idRol" class="form-label fw-semibold">
                        <i class="bi bi-shield-lock-fill me-1"></i>Rol
                    </label>
                    <select id="idRol"
                            name="idRol"
                            class="form-select form-select-lg"
                            required>
                        <option value="" disabled selected>-- Seleccione Rol --</option>
                        @foreach (var r in roles)
                        {
                            <option value="@r.IdRol">@r.RTipo</option>
                        }
                    </select>
                    <div class="invalid-feedback">
                        Debes elegir un rol.
                    </div>
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input"
                           type="checkbox"
                           id="terms"
                           required />
                    <label class="form-check-label" for="terms">
                        Acepto los <a href="#">términos y condiciones</a>.
                    </label>
                    <div class="invalid-feedback">
                        Debes aceptar términos.
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success btn-lg flex-grow-1">
                        <i class="bi bi-save2 me-2"></i>Registrar
                    </button>
                    <a asp-action="Login" class="btn btn-outline-secondary btn-lg flex-grow-1 text-center">
                        <i class="bi bi-x-circle me-2"></i>Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/js/intlTelInput.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/js/utils.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const form = document.getElementById("empleadoForm");
            const pwd = document.getElementById("contrasena_texto");
            const cfm = document.getElementById("confirm_contrasena");
            const pwdErr = document.getElementById("passwordError");
            const cfmErr = document.getElementById("confirmError");
            const submitBtn = form.querySelector('button[type="submit"]');

            // Patrón de contraseña: min 8, una mayúscula, un símbolo especial
            const pwdPattern = new RegExp(pwd.getAttribute("pattern"));

            function validatePwd() {
                if (!pwdPattern.test(pwd.value)) {
                    pwd.classList.add("is-invalid");
                    pwdErr.style.display = 'block';
                    return false;
                } else {
                    pwd.classList.remove("is-invalid");
                    pwdErr.style.display = 'none';
                    return true;
                }
            }

            function validateConfirm() {
                if (pwd.value !== cfm.value) {
                    cfm.classList.add("is-invalid");
                    cfmErr.style.display = 'block';
                    return false;
                } else {
                    cfm.classList.remove("is-invalid");
                    cfmErr.style.display = 'none';
                    return true;
                }
            }

            function toggleSubmit() {
                submitBtn.disabled = !(validatePwd() && validateConfirm() && form.checkValidity());
            }

            // Validación en tiempo real de contraseña y confirmación
            pwd.addEventListener("input", () => {
                validatePwd();
                validateConfirm();
                toggleSubmit();
            });
            cfm.addEventListener("input", () => {
                validateConfirm();
                toggleSubmit();
            });

            form.addEventListener("input", toggleSubmit);
            form.addEventListener("change", toggleSubmit);

            toggleSubmit();

            // intl-tel-input para teléfono (solo para formato visual)
            const input = document.querySelector("#pTelefono"),
                hidden = document.querySelector("#telefonoFormateado"),
                error = document.querySelector("#telefonoError"),
                iti = window.intlTelInput(input, {
                    initialCountry: "ni",
                    separateDialCode: true,
                    preferredCountries: ["ni"],
                    utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/js/utils.min.js"
                });

            function validatePhone() {
                if (input.value.trim() && !iti.isValidNumber()) {
                    error.classList.remove("d-none");
                    return false;
                }
                const numeroLocal = iti.getNumber(intlTelInputUtils.numberFormat.NATIONAL).replace(/\s+/g, '');
                if (!/^[2578][0-9]{7}$/.test(numeroLocal)) {
                    error.classList.remove("d-none");
                    return false;
                }
                error.classList.add("d-none");
                return true;
            }

            input.addEventListener("blur", validatePhone);
            form.addEventListener("submit", function (e) {
                if (validatePhone()) {
                    hidden.value = iti.getNumber(intlTelInputUtils.numberFormat.NATIONAL).replace(/\s+/g, '');
                } else {
                    e.preventDefault();
                }
                if (!(validatePwd() && validateConfirm() && form.checkValidity())) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                form.classList.add("was-validated");
            });

            // Formateo de cédula
            window.formatCedula = function (el) {
                let v = el.value.replace(/[^0-9A-Za-z]/g, '');
                if (v.length > 3 && v.length <= 9) v = v.slice(0, 3) + '-' + v.slice(3);
                if (v.length > 9) v = v.slice(0, 3) + '-' + v.slice(3, 9) + '-' + v.slice(9);
                el.value = v.toUpperCase();
            };
        });
    </script>
}
