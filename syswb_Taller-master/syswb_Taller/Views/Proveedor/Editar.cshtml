@model syswb_Taller.Models.Proveedor
@using syswb_Taller.Models

@{
    ViewBag.Title = "Editar Proveedor";
    int idProveedor = Model.IdProveedor;
    var todosProductos = ViewBag.TodosProductos as List<ProductoRepuesto> ?? new();
    var asociados = ViewBag.ProductosAsociados as List<ProveedorProducto> ?? new();
    var errorProd = TempData["ErrorProducto"] as string;
}
@section Header { }
@section Footer { }

@section Styles {
    <!-- Bootstrap Icons para que los checks/cruces se vean -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/css/intlTelInput.min.css" />
    <style>
        .price-cell {
            cursor: pointer;
        }

            .price-cell input {
                width: 100px;
                text-align: right;
            }
    </style>
}

<div class="container mt-4">

    @* Mensajes de alerta *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(errorProd))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorProd
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        @* — Datos del Proveedor — *@
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-pencil-square me-2"></i>Editar Proveedor
                </div>
                <div class="card-body">
                    <form asp-action="Editar" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@idProveedor" />

                        <div class="mb-3">
                            <label for="pNombre" class="form-label fw-semibold">
                                <i class="bi bi-building me-1"></i>Nombre
                            </label>
                            <input name="pNombre" id="pNombre"
                                   class="form-control"
                                   value="@Model.PNombre"
                                   required autofocus />
                        </div>
                        <div class="mb-3">
                            <label for="pTelefono" class="form-label fw-semibold">
                                <i class="bi bi-telephone-fill me-1"></i>Teléfono
                            </label>
                            <input type="tel" name="pTelefono" id="pTelefono"
                                   class="form-control"
                                   value="@Model.PTelefono"
                                   placeholder="Ingrese el número"
                                   required />
                            <div class="form-text text-danger mt-1 d-none"
                                 id="telefonoError">
                                Número de teléfono inválido.
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary flex-fill">
                                <i class="bi bi-save me-1"></i>Guardar Cambios
                            </button>
                            <a asp-action="Lista" class="btn btn-secondary flex-fill">
                                <i class="bi bi-x-circle me-1"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @* — Agregar Producto — *@
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <i class="bi bi-plus-circle-fill me-2"></i>Agregar Producto
                </div>
                <div class="card-body">
                    <form asp-action="AgregarProducto" method="post" class="row g-3" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="idProveedor" value="@idProveedor" />

                        <div class="col-md-7">
                            <label for="idProducto" class="form-label fw-semibold">
                                <i class="bi bi-box-seam me-1"></i>Producto
                            </label>
                            <select name="idProducto" id="idProducto"
                                    class="form-select" required>
                                <option value="">-- Selecciona --</option>
                                @foreach (var pr in todosProductos)
                                {
                                    <option value="@pr.IdProducto">@pr.PrNombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label for="precioRef" class="form-label fw-semibold">
                                <i class="bi bi-tag-fill me-1"></i>Precio Ref.
                            </label>
                            <input name="precioRef" id="precioRef" type="number"
                                   class="form-control"
                                   step="0.01" min="0"
                                   pattern="\d+(\.\d{1,2})?"
                                   required
                                   oninput="this.value = this.value.replace(/[^0-9.]/g,'').replace(/(\..*?)\..*/g,'$1');" />
                            <div class="invalid-feedback">
                                Ingrese un monto positivo (hasta dos decimales).
                            </div>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-success w-100">
                                <i class="bi bi-check-lg me-1"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @* — Productos Asociados — *@
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <i class="bi bi-list-check me-2"></i>Productos Asociados
                </div>
                <div class="card-body p-0">
                    <table class="table mb-0 table-hover align-middle">
                        <thead class="table-secondary">
                            <tr>
                                <th>Producto</th>
                                <th class="text-end">Precio Ref.</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (asociados.Any())
                            {
                                foreach (var pp in asociados)
                                {
                                    <tr data-producto="@pp.IdProducto">
                                        <td>@pp.IdProductoNavigation.PrNombre</td>
                                        <td class="text-end price-cell"
                                            data-precio="@pp.PrecioRef">
                                            @pp.PrecioRef.ToString("F2")
                                        </td>
                                        <td class="text-center">
                                            @* — Checkbox Toggle — *@
                                            <form asp-action="ToggleProducto" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="idProveedor" value="@idProveedor" />
                                                <input type="hidden" name="idProducto" value="@pp.IdProducto" />
                                                <div class="form-check d-inline-block">
                                                    <input name="activo"
                                                           type="checkbox"
                                                           class="form-check-input"
                                                           id="chk_@pp.IdProducto"
                                                           value="true"
                                                           onchange="this.form.submit()"
                                                    @(pp.Activo ? "checked" : "") />
                                                    <label class="form-check-label"
                                                           for="chk_@pp.IdProducto">
                                                        Activo
                                                    </label>
                                                </div>
                                            </form>

                                            @* Botón para editar precio *@
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary ms-2"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modal_@pp.IdProducto"
                                                    title="Editar Precio">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>

                                            @* Modal de edición de precio *@
                                            <div class="modal fade" id="modal_@pp.IdProducto" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <form asp-action="ActualizarProducto"
                                                              method="post" novalidate>
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="idProveedor" value="@idProveedor" />
                                                            <input type="hidden" name="idProducto" value="@pp.IdProducto" />

                                                            <div class="modal-header">
                                                                <h5 class="modal-title">
                                                                    <i class="bi bi-tag-fill me-1"></i>
                                                                    Precio — @pp.IdProductoNavigation.PrNombre
                                                                </h5>
                                                                <button type="button"
                                                                        class="btn-close"
                                                                        data-bs-dismiss="modal"></button>
                                                            </div>
                                                            <div class="modal-body">
                                                                <div class="mb-3">
                                                                    <label for="precioRefModal_@pp.IdProducto"
                                                                           class="form-label">
                                                                        Precio Ref.
                                                                    </label>
                                                                    <input name="precioRef"
                                                                           id="precioRefModal_@pp.IdProducto"
                                                                           type="number"
                                                                           class="form-control"
                                                                           step="0.01" min="0"
                                                                           pattern="\d+(\.\d{1,2})?"
                                                                           value="@pp.PrecioRef"
                                                                           required
                                                                           oninput="this.value = this.value.replace(/[^0-9.]/g,'').replace(/(\..*?)\..*/g,'$1');" />
                                                                    <div class="invalid-feedback">
                                                                        Ingrese un monto positivo válido.
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button"
                                                                        class="btn btn-secondary"
                                                                        data-bs-dismiss="modal">
                                                                    Cancelar
                                                                </button>
                                                                <button type="submit"
                                                                        class="btn btn-primary">
                                                                    Guardar
                                                                </button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4">
                                        <i class="bi bi-exclamation-circle me-1"></i>
                                        No hay productos asociados.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/js/intlTel-input.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/js/utils.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // — Teléfono —
            const inputTel = document.querySelector("#pTelefono");
            const errorMsgTel = document.querySelector("#telefonoError");
            const iti = window.intlTelInput(inputTel, {
                initialCountry: "ni",
                preferredCountries: ["ni", "sv", "cr", "mx", "us"],
                separateDialCode: true,
                utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/js/utils.min.js"
            });
            function validatePhone() {
                if (inputTel.value.trim() && !iti.isValidNumber()) {
                    errorMsgTel.classList.remove("d-none");
                    return false;
                }
                errorMsgTel.classList.add("d-none");
                return true;
            }
            document.querySelector("form[asp-action='Editar']")
                .addEventListener("submit", e => {
                    if (!validatePhone()) { e.preventDefault(); return; }
                    inputTel.value = iti.getNumber();
                });
            inputTel.addEventListener("blur", validatePhone);

            // — Inline‑edit precio —
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            document.querySelectorAll(".price-cell").forEach(td => {
                td.addEventListener("dblclick", () => {
                    if (td.querySelector("input")) return;
                    const orig = td.dataset.precio;
                    td.innerHTML = `
                                <input type="number" min="0" step="0.01" pattern="\\d+(\\.\\d{1,2})?" value="${orig}" class="form-control form-control-sm"
                                oninput="this.value = this.value.replace(/[^0-9.]/g,'').replace(/(\\..*?)\\..*/g,'$1');" />
                                <div class="invalid-feedback">Debe ser ≥ 0 y sin letras.</div>`;
                    const inp = td.querySelector("input");
                    inp.focus();
                    function finish(save) {
                        const v = parseFloat(inp.value);
                        if (save && !isNaN(v) && v >= 0) {
                            const row = td.closest("tr");
                            const form = document.createElement("form");
                            form.method = "post";
                            form.action = "@Url.Action("ActualizarProducto", "Proveedor")";
                            form.innerHTML = `
                                        <input name="__RequestVerificationToken" type="hidden" value="${token}">
                                        <input name="idProveedor" type="hidden" value="${idProveedor}">
                                        <input name="idProducto" type="hidden" value="${row.dataset.producto}">
                                        <input name="precioRef" type="hidden" value="${v.toFixed(2)}">`;
                            document.body.append(form);
                            form.submit();
                        } else {
                            td.textContent = parseFloat(orig).toFixed(2);
                        }
                    }
                    inp.addEventListener("blur", () => finish(true));
                    inp.addEventListener("keydown", e => {
                        if (e.key === "Enter") { e.preventDefault(); finish(true); }
                        if (e.key === "Escape") { finish(false); }
                    });
                });
            });
        });
    </script>
}
