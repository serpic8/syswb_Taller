@model syswb_Taller.Models.Proveedor

@{
    ViewBag.Title = "Agregar Proveedor";
}

@if (TempData["SuccessMessage"] != null)
{
    <script>alert("@TempData["SuccessMessage"]");</script>
}

@section Header { }
@section Footer { }

@section Styles {
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/intl-tel-input@17.0.19/build/css/intlTelInput.min.css" />
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0"><i class="bi bi-person-plus me-2"></i>Agregar Nuevo Proveedor</h2>
        </div>
        <div class="card-body">
            <form asp-action="Detalle"
                  method="post"
                  id="proveedorForm"
                  novalidate>
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label for="pNombre" class="form-label fw-semibold">
                        <i class="bi bi-person-fill me-1"></i>Nombre
                    </label>
                    <input type="text"
                           class="form-control form-control-lg"
                           id="pNombre"
                           name="pNombre"
                           placeholder="Ej: Distribuidora X"
                           required
                           autofocus />
                    <div class="invalid-feedback">
                        El nombre es obligatorio.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="pTelefono" class="form-label fw-semibold">
                        <i class="bi bi-telephone-fill me-1"></i>Teléfono
                    </label>
                    <input type="tel"
                           id="pTelefono"
                           class="form-control form-control-lg"
                           placeholder="Ingrese el número"
                           required />
                    <input type="hidden" name="pTelefono" id="telefonoFormateado" />

                    <div class="invalid-feedback" id="telefonoError">
                        Número de teléfono inválido.
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-success btn-lg flex-grow-1">
                        <i class="bi bi-save2 me-2"></i>Guardar
                    </button>
                    <a href="@Url.Action("Lista", "Proveedor")"
                       class="btn btn-outline-secondary btn-lg flex-grow-1 text-center">
                        <i class="bi bi-x-circle me-2"></i>Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@17.0.19/build/js/intlTelInput.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("proveedorForm");
            const nombreInput = document.getElementById("pNombre");
            const telefonoInput = document.getElementById("pTelefono");
            const hiddenInput = document.getElementById("telefonoFormateado");
            const telefonoError = document.getElementById("telefonoError");

            // Inicializar intl-tel-input
            const iti = window.intlTelInput(telefonoInput, {
                initialCountry: "ni",
                preferredCountries: ["ni", "sv", "cr", "mx", "us"],
                separateDialCode: true,
                utilsScript: "https://cdn.jsdelivr.net/npm/intl-tel-input@17.0.19/build/js/utils.js"
            });

            // Valida el teléfono con intl-tel-input
            function validatePhone() {
                if (telefonoInput.value.trim()) {
                    if (!iti.isValidNumber()) {
                        telefonoInput.classList.add("is-invalid");
                        telefonoError.style.display = "block";
                        return false;
                    } else {
                        telefonoInput.classList.remove("is-invalid");
                        telefonoInput.classList.add("is-valid");
                        telefonoError.style.display = "none";
                        return true;
                    }
                }
                return false;
            }

            // Validar el campo nombre
            function validateName() {
                if (!nombreInput.value.trim()) {
                    nombreInput.classList.add("is-invalid");
                    return false;
                } else {
                    nombreInput.classList.remove("is-invalid");
                    nombreInput.classList.add("is-valid");
                    return true;
                }
            }

            // Al enviar el formulario
            form.addEventListener("submit", function (e) {
                const validName = validateName();
                const validPhone = validatePhone();
                if (!validName || !validPhone) {
                    e.preventDefault();
                    e.stopPropagation();
                    form.classList.add("was-validated");
                    return;
                }

                // Guardar el número formateado
                hiddenInput.value = iti.getNumber();
            });

            // Eventos de validación en vivo
            nombreInput.addEventListener("blur", validateName);
            telefonoInput.addEventListener("blur", validatePhone);
            telefonoInput.addEventListener("input", function () {
                telefonoInput.classList.remove("is-invalid", "is-valid");
                telefonoError.style.display = "none";
            });
        });
    </script>
}
