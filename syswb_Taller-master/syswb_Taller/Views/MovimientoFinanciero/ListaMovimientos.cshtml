@model System.Data.DataTable

@{
    ViewBag.Title = "Lista de Movimientos Financieros";
    var movimientos   = ViewBag.Movimientos   as List<dynamic>;
    int?  anio         = ViewBag.Anio         as int?;
    int?  mes          = ViewBag.Mes          as int?;
    int?  dia          = ViewBag.Dia          as int?;
    string tipoMovimiento = ViewBag.TipoMovimiento as string ?? "";
    int   pageNumber   = ViewBag.PageNumber   ?? 1;
    int   totalPages   = ViewBag.TotalPages   ?? 1;

    string anioStr    = anio?.ToString() ?? "";
    string mesStr     = mes?.ToString() ?? "";
    string diaStr     = dia?.ToString() ?? "";
    string tipoStr    = tipoMovimiento;
    string qsParams   = $"&anio={anioStr}&mes={mesStr}&dia={diaStr}&tipoMovimiento={tipoStr}";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
@section Header { }
@section Footer { }

<style>
    .filter-bar {
        background: #fff;
        padding: 1rem;
        border-radius: .5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }
    .table-card {
        border-radius: .5rem;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    }
    .table-card .card-header {
        background: #0097cc;
        color: #fff;
        font-weight: 600;
    }
</style>

<div class="d-flex justify-content-end mb-3">
    <a asp-controller="Menu" asp-action="Menu"
       class="btn btn-outline-primary btn-lg shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-house-door-fill fs-5"></i>
        <span>Menú Principal</span>
    </a>
</div>

<h2 class="mb-4"><i class="bi bi-bank2 me-2"></i>Movimientos Financieros</h2>

<div class="filter-bar row align-items-center">
    <div class="col-md-6">
        <div class="btn-group" role="group">
            <a asp-controller="MovimientoFinanciero" asp-action="Resumen"
               class="btn btn-outline-secondary">
                <i class="bi bi-speedometer2 me-1"></i> Resumen
            </a>
            <a asp-controller="Empleado" asp-action="Lista"
               class="btn btn-outline-secondary">
                <i class="bi bi-people-fill me-1"></i> Trabajadores
            </a>
            <a asp-controller="Proveedor" asp-action="Lista"
               class="btn btn-outline-secondary">
                <i class="bi bi-truck-flatbed me-1"></i> Proveedores
            </a>
            <a asp-controller="MovimientoFinanciero" asp-action="ListaMovimientos"
               class="btn btn-primary">
                <i class="bi bi-cash-stack me-1"></i> Finanzas
            </a>
            <a asp-controller="CajaDiaria" asp-action="Lista"
               class="btn btn-outline-secondary">
                <i class="bi bi-box-seam me-1"></i> Caja Diaria
            </a>
        </div>
    </div>

    <form asp-controller="MovimientoFinanciero"
          asp-action="ListaMovimientos"
          method="get"
          class="col-md-6 d-flex justify-content-end align-items-end"
          id="filtroForm">

        <div class="me-3">
            <label for="anio" class="form-label mb-1">
                <i class="bi bi-calendar3 me-1"></i>Año
            </label>
            <input type="number"
                   class="form-control form-control-sm"
                   name="anio" id="anio"
                   value="@anioStr"
                   min="2000" max="@DateTime.Now.Year"
                   placeholder="Ej: 2025" />
        </div>

        <div class="me-3">
            <label for="mes" class="form-label mb-1">
                <i class="bi bi-calendar2-month me-1"></i>Mes
            </label>
            <select class="form-select form-select-sm"
                    name="mes" id="mes">
                <option value="">-- Todos --</option>
                @for (int i = 1; i <= 12; i++)
                {
                    <!option value="@i" @(mes == i ? "selected" : "")>
                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)
                    </!option>
                }
            </select>
        </div>

        <div class="me-3">
            <label for="dia" class="form-label mb-1">
                <i class="bi bi-calendar2-day me-1"></i>Día
            </label>
            <select class="form-select form-select-sm"
                    name="dia" id="dia"
                    @(anio == null || mes == null ? "disabled" : "")>
                <option value="">-- Todos --</option>
                @for (int d = 1; d <= DateTime.DaysInMonth(anio ?? DateTime.Now.Year, mes ?? 1); d++)
                {
                    <!option value="@d" @(dia == d ? "selected" : "")>@d</!option>
                }
            </select>
        </div>

        <div class="me-3">
            <label for="tipoMovimiento" class="form-label mb-1">
                <i class="bi bi-sliders me-1"></i>Tipo
            </label>
            <input type="text"
                   class="form-control form-control-sm"
                   name="tipoMovimiento"
                   id="tipoMovimiento"
                   value="@tipoStr"
                   placeholder="Ej: Ingreso, Egreso..." />
        </div>

        <button type="submit"
                class="btn btn-sm btn-primary align-self-end">
            <i class="bi bi-funnel-fill me-1"></i>Filtrar
        </button>
    </form>
</div>

<div class="table-card">
    <div class="card-header">
        <i class="bi bi-cash-coin me-2"></i> Lista de Movimientos
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Hora</th>
                    <th>Tipo</th>
                    <th>Responsable</th>
                    <th>Método Pago</th>
                    <th class="text-end">Monto</th>
                </tr>
            </thead>
            <tbody>
                @if (movimientos != null && movimientos.Any())
                {
                    foreach (var m in movimientos)
                    {
                        <tr>
                            <td>@m.IdMovimiento</td>
                            <td>@m.FechaCorta</td>
                            <td>@m.Hora</td>
                            <td>@m.TipoMovimiento</td>
                            <td>@m.Responsable</td>
                            <td>@m.MetodoPago</td>
                            <td class="text-end">@String.Format("{0:C}", m.Monto)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <i class="bi bi-exclamation-circle me-2"></i> No se encontraron movimientos.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<nav aria-label="Paginador" class="mt-4">
    <ul class="pagination justify-content-center">
        <li class="page-item @(pageNumber == 1 ? "disabled" : "")">
            <a class="page-link"
               href="?pageNumber=@(pageNumber - 1)@qsParams">Anterior</a>
        </li>

        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == pageNumber ? "active" : "")">
                <a class="page-link"
                   href="?pageNumber=@i@qsParams">@i</a>
            </li>
        }

        <li class="page-item @(pageNumber == totalPages ? "disabled" : "")">
            <a class="page-link"
               href="?pageNumber=@(pageNumber + 1)@qsParams">Siguiente</a>
        </li>
    </ul>
</nav>

@section Scripts {
    <script>
        function actualizarDias() {
            const anioInput = document.getElementById('anio');
            const mesSelect = document.getElementById('mes');
            const diaSelect = document.getElementById('dia');

            const anio = parseInt(anioInput.value);
            const mes = parseInt(mesSelect.value);

            if (!anio || !mes || mes < 1 || mes > 12) {
                diaSelect.innerHTML = '<option value="">-- Todos --</option>';
                diaSelect.disabled = true;
                return;
            }

            const diasEnMes = new Date(anio, mes, 0).getDate();
            const valorActual = diaSelect.value;

            let options = '<option value="">-- Todos --</option>';
            for (let d = 1; d <= diasEnMes; d++) {
                options += `<option value="${d}" ${d == valorActual ? 'selected' : ''}>${d}</option>`;
            }
            diaSelect.innerHTML = options;
            diaSelect.disabled = false;
        }

        document.getElementById('anio').addEventListener('input', actualizarDias);
        document.getElementById('mes').addEventListener('change', actualizarDias);
        window.onload = actualizarDias;
    </script>
}
