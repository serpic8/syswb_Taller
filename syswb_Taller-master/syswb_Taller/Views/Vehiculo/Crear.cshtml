@model dynamic
@{
    ViewBag.Title = "Crear Vehículo";
    int idCliente = ViewBag.IdCliente;
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

@section Header { }
@section Footer { }

<style>
    .form-card {
        background: #fff;
        border-radius: .5rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        padding: 2rem;
        max-width: 800px;
        margin: 2rem auto;
    }

        .form-card h2 {
            color: #0097cc;
            margin-bottom: 1rem;
        }

    .btn-submit {
        background: #0097cc;
        color: #fff;
        transition: background .3s;
    }

        .btn-submit:hover {
            background: #007bb3;
        }
</style>

<div class="form-card">
    <h2><i class="bi bi-car-front-fill me-2"></i>Crear Vehículo para Cliente #@idCliente</h2>

    <form asp-action="Crear" method="post" novalidate id="vehiculoForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="idCliente" value="@idCliente" />
        <input type="hidden" name="redirigirA" value="@ViewBag.Redireccion" />

        <div class="row g-3">
            <div class="col-md-4">
                <label for="vhMarca" class="form-label">Marca</label>
                <select id="vhMarca" name="vhMarca" class="form-select" required></select>
                <div class="invalid-feedback">Debe elegir una marca válida.</div>
            </div>

            <div class="col-md-4">
                <label for="vhModelo" class="form-label">Modelo</label>
                <select id="vhModelo" name="vhModelo" class="form-select" required disabled></select>
                <div class="invalid-feedback">Debe elegir un modelo válido.</div>
            </div>

            <div class="col-md-2">
                <label for="vhAño" class="form-label">Año</label>
                <select id="vhAño" name="vhAño" class="form-select" required disabled></select>
                <div class="invalid-feedback">Debe elegir un año válido.</div>
            </div>

            <div class="col-md-2">
                <label class="form-label">Estado</label>
                <input name="vhEstado" class="form-control" value="Disponible" readonly />
            </div>

            <div class="col-md-4">
                <label for="vhColor" class="form-label">Color</label>
                <select id="vhColor" name="vhColor" class="form-select" required></select>
                <div class="invalid-feedback">Debe elegir un color válido.</div>
            </div>

            <div class="col-md-4">
                <label for="vhMatricula" class="form-label">Matrícula</label>
                <input type="text" name="vhMatricula" id="vhMatricula" class="form-control" required pattern="^[A-Z0-9\-]+$" />
                <div class="invalid-feedback">Ingrese una matrícula válida (solo letras, números o guiones).</div>
            </div>
        </div>

        <div class="row g-3 mt-3">
            <div class="col-md-6">
                <button type="submit" class="btn btn-submit w-100">Guardar Vehículo</button>
            </div>
            <div class="col-md-6">
                <a asp-controller="Vehiculo" asp-action="Lista" asp-route-id="@idCliente" class="btn btn-outline-secondary w-100">Volver</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const marcaSel = $('#vhMarca');
            const modeloSel = $('#vhModelo');
            const añoSel = $('#vhAño');
            const colorSel = $('#vhColor');
            const form = document.getElementById("vehiculoForm");

            // Inicializar Select2 para marcas, modelos, años
            marcaSel.select2({ placeholder: "-- Seleccione Marca --", width: '100%' });
            modeloSel.select2({ placeholder: "-- Seleccione Modelo --", width: '100%' });
            añoSel.select2({ placeholder: "-- Seleccione Año --", width: '100%' });

            // Lista de colores con hex para cuadrito
            const colores = [
                { id: "Rojo", text: "Rojo", color: "#FF0000" },
                { id: "Verde", text: "Verde", color: "#00FF00" },
                { id: "Azul", text: "Azul", color: "#0000FF" },
                { id: "Amarillo", text: "Amarillo", color: "#FFFF00" },
                { id: "Negro", text: "Negro", color: "#000000" },
                { id: "Blanco", text: "Blanco", color: "#FFFFFF" },
                { id: "Gris", text: "Gris", color: "#808080" },
                { id: "Naranja", text: "Naranja", color: "#FFA500" },
                { id: "Morado", text: "Morado", color: "#800080" },
                { id: "Celeste", text: "Celeste", color: "#87CEEB" },
                { id: "Rosa", text: "Rosa", color: "#FFC0CB" },
                { id: "Marrón", text: "Marrón", color: "#A52A2A" },
                { id: "Dorado", text: "Dorado", color: "#FFD700" },
                { id: "Plata", text: "Plata", color: "#C0C0C0" }
            ];

            // Inicializar Select2 para colores con cuadrito
            function formatColorOption(state) {
                if (!state.id) {
                    return state.text;
                }
                const color = colores.find(c => c.text === state.text);
                if (!color) return state.text;

                const $colorBox = $(
                    `<span style="display:inline-block;width:16px;height:16px;margin-right:8px;vertical-align:middle;
                            background-color:${color.color};border:1px solid #ccc;"></span>`
                );
                const $container = $('<span></span>');
                $container.append($colorBox);
                $container.append(state.text);
                return $container;
            }

            colorSel.select2({
                placeholder: "-- Seleccione Color --",
                data: colores,
                templateResult: formatColorOption,
                templateSelection: formatColorOption,
                escapeMarkup: markup => markup,
                width: '100%'
            });

            // Cargar marcas desde NHTSA API
            axios.get("https://vpic.nhtsa.dot.gov/api/vehicles/getallmakes?format=json")
                .then(res => {
                    const marcas = res.data.Results;
                    marcas.sort((a, b) => a.Make_Name.localeCompare(b.Make_Name));
                    marcas.forEach(m => {
                        marcaSel.append(new Option(m.Make_Name, m.Make_Name));
                    });
                })
                .catch(() => alert("Error cargando marcas"));

            // Evento Marca → Modelo
            marcaSel.on("change", function () {
                const marca = this.value;
                modeloSel.prop("disabled", true).empty().append(new Option());
                añoSel.prop("disabled", true).empty().append(new Option());
                if (!marca) return;

                axios.get(`https://vpic.nhtsa.dot.gov/api/vehicles/GetModelsForMake/${encodeURIComponent(marca)}?format=json`)
                    .then(res => {
                        const modelos = res.data.Results;
                        modelos.sort((a, b) => a.Model_Name.localeCompare(b.Model_Name));
                        modelos.forEach(m => {
                            modeloSel.append(new Option(m.Model_Name, m.Model_Name));
                        });
                        modeloSel.prop("disabled", false);
                    })
                    .catch(() => alert("Error cargando modelos"));
            });

            // Evento Modelo → Año
            modeloSel.on("change", function () {
                const modelo = this.value;
                añoSel.prop("disabled", true).empty().append(new Option());
                if (!modelo) return;

                for (let y = 2025; y >= 1995; y--) {
                    añoSel.append(new Option(y, y));
                }
                añoSel.prop("disabled", false);
            });

            // Validación Bootstrap
            form.addEventListener("submit", e => {
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                form.classList.add("was-validated");
            });
        });
    </script>
}
