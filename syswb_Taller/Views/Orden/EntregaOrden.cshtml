@model syswb_Taller.Models.OrdenDetalleEntrega

@{
    bool esCreacion = Model.IdEntrega == 0;
    ViewBag.Title = esCreacion ? "Registrar Entrega" : "Ver Entrega";
    string ordenEntregaGenerada = "OE-" + Model.IdOrden.ToString("D4") + "-" + DateTime.Now.Year;
    var mecanicoPreasignado = ViewBag.MecanicoAsignado as int?;
}
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

@section Header { }
@section Footer { }

<form asp-action="@(esCreacion ? "AgregarEntrega" : "ActualizarEntrega")"
      method="post"
      class="container mt-5 p-4 bg-white rounded shadow-sm border"
      style="max-width: 720px;">

    @Html.AntiForgeryToken()

    <h3 class="mb-4 text-primary fw-bold border-bottom pb-2">
        <i class="bi bi-box-seam me-2"></i>@ViewBag.Title
    </h3>

    <input type="hidden" name="idOrden" value="@Model.IdOrden" />
    @if (!esCreacion)
    {
        <input type="hidden" name="idEntrega" value="@Model.IdEntrega" />
    }

    <div class="mb-4">
        <label class="form-label fw-semibold text-secondary">Orden de entrega</label>
        <div class="form-control-plaintext fw-bold fs-5 text-dark bg-light p-2 rounded border">
            @(esCreacion ? ordenEntregaGenerada : Model.OrdenEntrega)
        </div>
        <input type="hidden" name="orden_entrega"
               value="@(esCreacion ? ordenEntregaGenerada : Model.OrdenEntrega)" />
    </div>

    <div class="mb-4">
        <label for="recibido_por" class="form-label fw-semibold">Recibido por</label>
        <input name="recibido_por" id="recibido_por"
               class="form-control form-control-lg border-primary"
               value="@(esCreacion ? "" : Model.RecibidoPor)"
        @(esCreacion ? "required" : "readonly") />
    </div>

    <div class="mb-4">
        <label for="telefono_recibe" class="form-label fw-semibold">Teléfono quien recibe</label>
        <input name="telefono_recibe" id="telefono_recibe"
               class="form-control form-control-lg border-primary"
               value="@(esCreacion ? "" : Model.TelefonoRecibe)"
        @(esCreacion ? "required" : "readonly") />
    </div>

    <div class="mb-4 form-check form-switch">
        <input class="form-check-input"
               type="checkbox"
               name="es_propietario" id="es_propietario"
        @(!esCreacion && Model.EsPropietario ? "checked" : "")
        @(esCreacion ? "" : "disabled") />
        <label class="form-check-label fw-semibold" for="es_propietario">¿Es propietario?</label>
    </div>

    <div class="mb-4">
        <label for="entregado_por" class="form-label fw-semibold">Entregado por (empleado)</label>
        <select name="entregado_por" id="entregado_por"
                class="form-select form-select-lg border-primary"
        @(esCreacion ? "required" : "disabled")>
            <option value="" selected>Seleccione empleado</option>
            @{
                var empleadosActivos = ViewBag.EmpleadosActivos as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
            }
            @foreach (var e in empleadosActivos)
            {
                <!option value="@e.IdEmpleado"
                @(!esCreacion && e.IdEmpleado == Model.EntregadoPor ? "selected" : "")>
                    @e.NombreCompleto
                </!option>
            }
        </select>
    </div>

    <div class="mb-4">
        <label for="mecanico_responsable" class="form-label fw-semibold">Mecánico responsable</label>
        <select name="mecanico_responsable" id="mecanico_responsable"
                class="form-select form-select-lg border-primary"
        @(esCreacion ? "required" : "disabled")>
            <option value="" selected>Seleccione mecánico</option>
            @{
                var mecanicos = ViewBag.Mecanicos as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
            }
            @foreach (var e in mecanicos)
            {
                bool seleccionado = (!esCreacion && e.IdEmpleado == Model.MecanicoResponsable)
                || (esCreacion && mecanicoPreasignado == e.IdEmpleado);
                <!option value="@e.IdEmpleado" @(seleccionado ? "selected" : "")>
                    @e.NombreCompleto
                </!option>
            }
        </select>
    </div>

    <div class="mb-5">
        <label for="informe_tecnico" class="form-label fw-semibold">Informe técnico</label>
        <textarea name="informe_tecnico" id="informe_tecnico"
                  class="form-control form-control-lg border-primary"
                  rows="5"
        @(esCreacion ? "required" : "readonly")>@(esCreacion ? "" : Model.InformeTecnico)</textarea>
    </div>

    <div class="d-flex justify-content-end">
        @if (esCreacion)
        {
            <button type="button" class="btn btn-success btn-lg me-3" onclick="confirmarEntrega()">
                <i class="bi bi-check-circle me-2"></i>Registrar Entrega
            </button>
        }
        else
        {
            <button type="button" class="btn btn-primary btn-lg me-3" onclick="window.print()">
                <i class="bi bi-file-earmark-pdf me-2"></i>Imprimir PDF
            </button>
        }
        <a asp-action="Editar" asp-controller="Orden" asp-route-id="@Model.IdOrden" class="btn btn-secondary btn-lg">
            <i class="bi bi-arrow-left-circle me-2"></i>Volver
        </a>
    </div>

    @* Modal de confirmación sólo en creación *@
    @if (esCreacion)
    {
        <div class="modal fade" id="modalConfirmacion" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-primary shadow-sm">
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title"><i class="bi bi-question-circle me-2"></i>¿Está seguro?</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body fs-5">
                        ¿Confirma registrar esta entrega?
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-primary btn-lg">Sí</button>
                        <button type="button" class="btn btn-secondary btn-lg" data-bs-dismiss="modal">No</button>
                    </div>
                </div>
            </div>
        </div>
    }
</form>

@section Scripts {
    <script>
        function confirmarEntrega() {
            var m = new bootstrap.Modal(document.getElementById('modalConfirmacion'));
            m.show();
        }
    </script>
}

@section Styles {
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        form.container {
            box-shadow: 0 4px 10px rgb(0 0 0 / 0.1), 0 0 0 1px rgb(0 0 0 / 0.05);
        }

        label.form-label {
            letter-spacing: 0.02em;
            color: #495057;
        }

        textarea.form-control[readonly], input.form-control[readonly] {
            background-color: #e9ecef !important;
            color: #495057 !important;
            cursor: default;
        }

        @@media print {
            button, a.btn, .form-control, select, textarea, input {
                display: none !important;
            }
        }
    </style>
}
