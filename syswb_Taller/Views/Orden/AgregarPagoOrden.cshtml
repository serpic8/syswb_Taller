@model syswb_Taller.Models.DetallePagoOrden
@using System.Security.Claims

@{
    ViewBag.Title = "Registrar Pago";
    var fechaHora      = (string)ViewBag.FechaHora;
    var numeroFactura  = "FAC-" + Model.IdOrden.ToString("D4") + "-" + DateTime.Now.Year;
    var yaPagado       = (bool)ViewBag.YaPago;
    var empleadoNombre = (string)ViewBag.EmpleadoNombre;
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
      integrity="sha512-b7Q+XU+PsnVkffOQgTjneFMXGKDSrGHZiEccpJmJHGkjlCNdZxH79ResCi1cdA3YbUUJF6X0Y+hZ7XWoxx+G6g=="
      crossorigin="anonymous" referrerpolicy="no-referrer" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<style>
  .invoice-header {
    background: linear-gradient(135deg, #0d6efd, #6610f2);
    color: #fff;
    padding: 1.5rem 2rem;
    border-radius: 0.5rem 0.5rem 0 0;
    box-shadow: 0 4px 15px rgba(102, 16, 242, 0.4);
  }
  .invoice-header h4 {
    font-weight: 700;
    font-size: 1.8rem;
  }
  .invoice-header span {
    font-size: 1rem;
    font-weight: 500;
  }
  .invoice-body {
    border: 1px solid #dee2e6;
    border-top: none;
    padding: 2rem 2rem 2.5rem;
    border-radius: 0 0 0.5rem 0.5rem;
    background: #fff;
    box-shadow: 0 4px 12px rgb(13 110 253 / 0.15);
  }
  dl.row dt {
    font-weight: 600;
    color: #495057;
  }
  dl.row dd {
    font-size: 1.1rem;
    font-weight: 500;
  }
  .btn-gradient-primary {
    background: linear-gradient(90deg, #6610f2 0%, #0d6efd 100%);
    border: none;
    font-weight: 600;
  }
  .btn-gradient-primary:hover, 
  .btn-gradient-primary:focus {
    background: linear-gradient(90deg, #0d6efd 0%, #6610f2 100%);
  }
  .form-label {
    font-weight: 600;
    font-size: 1rem;
  }
  .form-control[readonly] {
    background-color: #f8f9fa;
  }
  .form-check-label {
    font-weight: 500;
  }
  .form-check-input:checked {
    background-color: #6610f2;
    border-color: #6610f2;
  }
  /* Print mode: hide buttons */
  @@media print {
    .btn, a.btn {
      display: none !important;
    }
  }
</style>

@section Header { }
@section Footer { }

@if (yaPagado)
{
    <div class="container animate__animated animate__fadeIn" style="max-width: 700px;">
      <div class="invoice-header d-flex justify-content-between align-items-center mb-4">
        <h4><i class="bi bi-check-circle-fill me-2"></i>Pago Registrado</h4>
        <span class="text-light">@fechaHora</span>
      </div>
      <div class="invoice-body rounded-3">
        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
          <h5 class="mb-0">Factura Orden #@Model.IdOrden</h5>
          <div class="text-end">
            <label class="form-label mb-1 small text-muted">Factura No.</label>
            <div class="fw-bold fs-5">@numeroFactura</div>
          </div>
        </div>
        <dl class="row mb-4">
          <dt class="col-sm-4">Monto Pagado</dt>
          <dd class="col-sm-8 text-success fs-5">@Model.MontoPagado.ToString("C")</dd>

          <dt class="col-sm-4">Método de Pago</dt>
          <dd class="col-sm-8">@Model.MetodoPago</dd>

          <dt class="col-sm-4">Detalles</dt>
          <dd class="col-sm-8">@Model.Observaciones</dd>

          <dt class="col-sm-4">Registrado por</dt>
          <dd class="col-sm-8">@empleadoNombre</dd>
        </dl>

        <div class="text-end">
          <button class="btn btn-primary me-2" onclick="window.print()">
            <i class="bi bi-file-earmark-pdf me-1"></i> Imprimir PDF
          </button>
          <a asp-action="Editar" asp-controller="Orden" asp-route-id="@Model.IdOrden"
             class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left-circle me-1"></i> Volver
          </a>
        </div>
      </div>
    </div>
}
else
{
    <div class="container animate__animated animate__fadeIn" style="max-width: 600px;">
      <div class="invoice-header d-flex justify-content-between align-items-center mb-4">
        <h4><i class="bi bi-credit-card-fill me-2"></i>@ViewBag.Title</h4>
        <span class="text-light">@fechaHora</span>
      </div>
      <div class="invoice-body rounded-3">
        @if (TempData.ContainsKey("Error"))
        {
          <div class="alert alert-warning animate__animated animate__shakeX d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>
            <div>@TempData["Error"]</div>
          </div>
        }

        <form asp-controller="Orden" asp-action="AgregarPagoOrden"
              method="post" novalidate class="needs-validation animate__animated animate__fadeInUp">
          @Html.AntiForgeryToken()
          <input type="hidden" asp-for="IdOrden" />
          <input type="hidden" name="idCliente" value="@ViewBag.ClienteID" />

          <div class="mb-4">
            <label class="form-label">Monto a pagar</label>
            <input type="text" class="form-control border-primary fs-5 fw-bold"
                   value="@Model.MontoPagado.ToString("C")" readonly />
            <input type="hidden" asp-for="MontoPagado" />
          </div>

          <div class="mb-4">
            <label class="form-label">Forma de Pago <span class="text-danger">*</span></label>
            <div>
              @foreach (var fp in new[] { "Contado", "Tarjeta", "Transferencia" })
              {
                <div class="form-check form-check-inline">
                  <input class="form-check-input"
                         type="radio"
                         asp-for="MetodoPago"
                         value="@fp"
                         required
                         id="fp_@fp" />
                  <label class="form-check-label" for="fp_@fp">@fp</label>
                </div>
              }
            </div>
            <div class="invalid-feedback d-block">Seleccione una forma de pago.</div>
          </div>

          <div class="mb-4">
            <label asp-for="Observaciones" class="form-label">Detalles del Pago</label>
            <textarea asp-for="Observaciones" class="form-control" rows="4" placeholder="Opcional..."></textarea>
          </div>

          <div class="mb-4">
            <label class="form-label">Empleado que registra</label>
            <input type="text" class="form-control bg-light fw-semibold" value="@empleadoNombre" readonly />
            <input type="hidden" asp-for="IdEmpleado" />
          </div>

          <div class="text-end">
            <button type="submit"
                    class="btn btn-gradient-primary animate__animated animate__pulse px-4 py-2 fs-5">
              <i class="bi bi-credit-card-fill me-2"></i> Confirmar Pago
            </button>
            <a asp-action="Editar" asp-controller="Orden" asp-route-id="@Model.IdOrden"
               class="btn btn-outline-secondary ms-3 px-4 py-2 fs-5">
              <i class="bi bi-x-circle me-2"></i> Cancelar
            </a>
          </div>
        </form>
      </div>
    </div>
}

@section Scripts {
  <script>
    (function () {
      'use strict';
      document.querySelectorAll('.needs-validation').forEach(form => {
        form.addEventListener('submit', e => {
          if (!form.checkValidity()) {
            e.preventDefault(); e.stopPropagation();
            form.classList.add('animate__animated','animate__shakeX');
          }
          form.classList.add('was-validated');
        });
      });
    })();
  </script>
}
