@model syswb_Taller.Models.DetallePagoOrden

@{
    ViewBag.Title = "Registrar Pago";

    // Número de factura con formato: FAC-0001-2025
    var numeroFactura = "FAC-" + Model.IdOrden.ToString("D4") + "-" + DateTime.Now.Year;
}

<form asp-action="AgregarPagoOrden" method="post" class="container mt-4">
    @Html.AntiForgeryToken()

    <input asp-for="IdOrden" type="hidden" />
    <input name="idCliente" type="hidden" value="@ViewBag.IdCliente" />
    <input type="hidden" name="NumeroFactura" value="@numeroFactura" />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Registrar Pago de Orden #@Model.IdOrden</h4>
        <div class="text-end">
            <label class="form-label mb-0">Factura No.</label>
            <div class="fw-bold">@numeroFactura</div>
        </div>
    </div>

    <div class="mb-3">
        <label for="observaciones" class="form-label">Detalles del Pago</label>
        <textarea asp-for="Observaciones"
                  class="form-control"
                  id="observaciones"
                  rows="3"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Forma de Pago</label><br />
        @foreach (var fp in new[] { "Contado", "Tarjeta", "Transferencia" })
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input"
                       type="radio"
                       name="metodoPago"
                       value="@fp"
                @(fp == "Contado" ? "checked" : "") />
                <label class="form-check-label">@fp</label>
            </div>
        }
    </div>

    <div class="mb-3">
        <label for="idEmpleado" class="form-label">Empleado que registra</label>
        <select asp-for="IdEmpleado" class="form-select">
            <option value="">– Seleccione –</option>
            @{
                var empleados = ViewBag.Empleados as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
            }
            @foreach (var emp in empleados)
            {
                <option value="@emp.IdEmpleado">@emp.NombreCompleto</option>
            }
        </select>
    </div>

    <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-success me-2">Confirmar Pago</button>
        <a asp-action="Editar" asp-route-id="@Model.IdOrden" class="btn btn-secondary">Cancelar</a>
    </div>
</form>
