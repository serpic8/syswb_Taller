@model syswb_Taller.Models.OrdenDetalleEntrega

@{
    ViewBag.Title = "Detalle de Entrega";
    string fechaHora = Model.FechaEntrega.ToString("dd/MM/yyyy HH:mm") 
                       ?? DateTime.Now.ToString("dd/MM/yyyy HH:mm");
}

@section Header { }
@section Footer { }


<div class="d-flex justify-content-between align-items-center mb-4">
    <h4>@ViewBag.Title</h4>
    <span class="text-muted">@fechaHora</span>
</div>

<dl class="row">
    <dt class="col-sm-3">Orden de Entrega</dt>
    <dd class="col-sm-9">@Model.OrdenEntrega</dd>

    <dt class="col-sm-3">Recibido por</dt>
    <dd class="col-sm-9">@Model.RecibidoPor</dd>

    <dt class="col-sm-3">Teléfono quien recibe</dt>
    <dd class="col-sm-9">@Model.TelefonoRecibe</dd>

    <dt class="col-sm-3">Es propietario</dt>
    <dd class="col-sm-9">@(Model.EsPropietario ? "Sí" : "No")</dd>

    <dt class="col-sm-3">Entregado por (empleado)</dt>
    <dd class="col-sm-9">@Model.EntregadoPor</dd>

    <dt class="col-sm-3">Mecánico responsable</dt>
    <dd class="col-sm-9">@Model.MecanicoResponsable</dd>

    <dt class="col-sm-3">Informe técnico</dt>
    <dd class="col-sm-9">@Html.DisplayFor(m => m.InformeTecnico)</dd>
</dl>

<div class="text-end">
    <button type="button" class="btn btn-secondary" onclick="window.print();">
        <i class="bi bi-printer"></i> Imprimir
    </button>
    <a asp-action="Editar" asp-controller="Orden" asp-route-id="@Model.IdOrden" class="btn btn-outline-secondary ms-2">
        Volver
    </a>
</div>

@section Styles {
    <style>
    @@media print {
      .btn, a.btn { display: none !important; }
    }
    </style>
}
