@{
}
@model List<syswb_Taller.Models.Empleado>;
<div class="row">
    <div class="col-sm-8 offset-sm-2">
        <h2>lista empleados</h2>

        <table class="col-sm-8 offset-sm-2">
            <thead>
                <tr>
                    <th>IdEmpleado</th>
                    <th>Usuario</th>
                    @* <th>Rol</th> *@
                    <th>Activo</th>

                </tr>

            </thead>
             <tbody>
                 @foreach(var item in Model) @*Aca podria o crear una vista o un metodo get que llame a lo que quiero*@
                {
                   <tr>
                       <td>@item.IdEmpleado</td>
                       <td>@item.EmpUsuario</td>
                       @* <td></td> *@
                       <td>@(item.EmpActivo ? "SI" : "NO")</td>


                   </tr>   
                }

             </tbody> 

        </table>

    </div>


</div>