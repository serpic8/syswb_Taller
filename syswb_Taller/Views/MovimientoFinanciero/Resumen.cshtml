@using System.Globalization
@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"
@{
    ViewData["Title"] = "Resumen Mensual";

    // Cultura de Nicaragua
    var nicaragua = new CultureInfo("es-NI");

    // Valores desde ViewBag
    var ingresos = (double)ViewBag.TotalIngresos;
    var egresos = (double)ViewBag.TotalEgresos;
    var balance = (double)ViewBag.Balance;
    var actividades = (List<syswb_Taller.Models.MovimientoFinanciero>)ViewBag.Actividades;
    var ordenes = (List<dynamic>)ViewBag.Ordenes;

    // Filtros actuales
    int selYear = (int)(ViewBag.SelectedYear ?? DateTime.Today.Year);
    int selMonth = (int)(ViewBag.SelectedMonth ?? DateTime.Today.Month);

    // Listas para dropdowns
    var years = Enumerable.Range(DateTime.Today.Year - 5, 6).Reverse().ToList();
    var months = Enumerable.Range(1, 12)
                  .Select(m => new { Value = m, Name = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m) })
                  .ToList();
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
@section Header { }
@section Footer { }

<style>


    .filter-bar {
        background: #fff;
        padding: 1rem;
        border-radius: .5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }

    .metric-card {
        border-radius: .75rem;
        box-shadow: 0 4px 16px rgba(0,0,0,0.05);
        overflow: hidden;
        transition: transform .2s;
    }

        .metric-card:hover {
            transform: translateY(-4px);
        }

    .metric-header {
        padding: 1rem;
        color: #fff;
        display: flex;
        align-items: center;
    }

        .metric-header i {
            font-size: 2rem;
            margin-right: .75rem;
        }

    .metric-body {
        padding: 1.5rem;
        background: #fff;
        text-align: center;
    }

        .metric-body .value {
            font-size: 2.25rem;
            font-weight: 700;
        }

    .table-card {
        border-radius: .5rem;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    }

        .table-card .card-header {
            background: #0097cc;
            color: #fff;
            font-weight: 600;
        }
</style>

<div class="d-flex justify-content-end mb-3">
    <a asp-controller="Menu" asp-action="Menu"
       class="btn btn-outline-primary btn-lg shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-house-door-fill fs-5"></i>
        <span>Menú Principal</span>
    </a>
</div>


<div class="filter-bar row align-items-center">
    <div class="col-md-6">
        <div class="btn-group" role="group">
            <a href="@Url.Action("Resumen", "MovimientoFinanciero")" class="btn btn-primary">
                <i class="bi bi-speedometer2 me-1"></i> Resumen
            </a>
            <a href="@Url.Action("Lista", "Empleado")" class="btn btn-outline-secondary">
                <i class="bi bi-people-fill me-1"></i> Empleados
            </a>
            <a href="@Url.Action("Lista", "Proveedor")" class="btn btn-outline-secondary">
                <i class="bi bi-truck-flatbed me-1"></i> Proveedores
            </a>
            <a href="@Url.Action("ListaMovimientos", "MovimientoFinanciero")" class="btn btn-outline-secondary">
                <i class="bi bi-cash-stack me-1"></i> Finanzas
            </a>
            <a href="@Url.Action("Lista", "CajaDiaria")" class="btn btn-outline-secondary">
                <i class="bi bi-box-seam me-1"></i> Caja Diaria
            </a>
        </div>
    </div>
    <form asp-action="Resumen" method="get" class="col-md-6 d-flex justify-content-end align-items-center">
        <label class="me-2">Mes:</label>
        <select name="mes" class="form-select form-select-sm me-3" style="width:auto">
            @foreach (var m in months)
            {
                <option value="@m.Value" @(m.Value == selMonth ? "selected" : "")>
                    @CultureInfo.CurrentCulture.TextInfo.ToTitleCase(m.Name)
                </option>
            }
        </select>
        <label class="me-2">Año:</label>
        <select name="anio" class="form-select form-select-sm me-3" style="width:auto">
            @foreach (var y in years)
            {
                <option value="@y" @(y == selYear ? "selected" : "")>@y</option>
            }
        </select>
        <button type="submit" class="btn btn-sm btn-primary">
            <i class="bi bi-funnel-fill me-1"></i> Filtrar
        </button>
    </form>
</div>

<h2 class="mb-4">
    @ViewData["Title"] -
    @CultureInfo.CurrentCulture.TextInfo.ToTitleCase(
            new DateTime(selYear, selMonth, 1).ToString("MMMM yyyy", nicaragua)
            )
</h2>

<div class="row mb-5 g-4">
    <div class="col-md-4">
        <div class="metric-card">
            <div class="metric-header" style="background:#28a745;">
                <i class="bi bi-arrow-down-circle-fill"></i>
                <div>Ingresos</div>
            </div>
            <div class="metric-body">
                <div class="value text-success">
                    @ingresos.ToString("C2", nicaragua)
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <div class="metric-header" style="background:#dc3545;">
                <i class="bi bi-arrow-up-circle-fill"></i>
                <div>Egresos</div>
            </div>
            <div class="metric-body">
                <div class="value text-danger">
                    @egresos.ToString("C2", nicaragua)
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <div class="metric-header" style="background:#007bff;">
                <i class="bi bi-calculator-fill"></i>
                <div>Balance</div>
            </div>
            <div class="metric-body">
                <div class="value">
                    @balance.ToString("C2", nicaragua)
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card table-card">
            <div class="card-header">
                <i class="bi bi-list-check me-2"></i> Últimos Movimientos
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th class="text-end">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mv in actividades)
                        {
                            <tr>
                                <td>@mv.MovFecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@mv.MvTipoMovimiento</td>
                                <td class="text-end">@mv.MovMonto.ToString("C2", nicaragua)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card table-card">
            <div class="card-header">
                <i class="bi bi-receipt-cutoff me-2"></i> Órdenes Recientes
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Creación</th>
                            <th>Estado</th>
                            <th>Pago</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in ordenes)
                        {
                            <tr>
                                <td>@o.IdOrden</td>
                                <td>@((DateTime)o.OrFechaCreacion).ToString("dd/MM/yyyy")</td>
                                <td>@o.OrEstado</td>
                                <td>
                                    @((DateTime)o.FechaPago).ToString("dd/MM/yyyy")<br />
                                    <span class="text-end d-block">
                                        @((decimal)o.MontoPagado).ToString("C2", nicaragua)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
