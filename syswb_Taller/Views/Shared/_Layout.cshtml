@inject syswb_Taller.Models.BdTallerContext _bdContext
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var showAppNavigation = User.Identity?.IsAuthenticated == true
        && currentController != "Menu"
        && currentController != "Login";

    bool cajaAbierta = false;
    if (showAppNavigation)
    {
        try
        {
            cajaAbierta = _bdContext.CajaDiaria.Any(c => c.CjCierre == null);
        }
        catch { }
    }

    var role = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Taller</title>
    <!-- Google Fonts: Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/syswb_Taller.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@17.0.19/build/css/intlTelInput.min.css" />
    @RenderSection("Styles", required: false)
</head>
<body class="@(showAppNavigation ? "app-body" : "")">
    @if (showAppNavigation)
    {
        <header class="app-header">
            <nav class="navbar navbar-expand-lg app-navbar py-2" aria-label="Navegación principal">
                <div class="container-fluid app-nav-container d-flex align-items-center justify-content-between">
                    
                    <!-- LADO IZQUIERDO: LOGO IDENTIDAD -->
                    <a class="navbar-brand app-brand m-0" asp-controller="Menu" asp-action="Menu" title="Taller+ - Volver al Menú">
                        <span class="brand-mark"><i class="bi bi-wrench-adjustable-circle-fill" aria-hidden="true"></i></span>
                        <div class="d-flex flex-column justify-content-center">
                            <span class="brand-text">Taller<span class="brand-accent">+</span></span>
                            <small class="brand-subtext">Gestión operativa</small>
                        </div>
                    </a>

                    <!-- LADO DERECHO: ACCIONES (MENÚ, CAJA, USUARIO) -->
                    <div class="d-flex align-items-center gap-2 gap-sm-3">
                        <!-- Botón Menú Principal -->
                        <a asp-controller="Menu" asp-action="Menu" class="btn-nav-menu" title="Volver al Menú Principal">
                            <i class="bi bi-grid-fill"></i>
                            <span>Menú</span>
                        </a>

                        <!-- Píldora Estado de Caja -->
                        <span class="status-caja-pill @(cajaAbierta ? "abierta" : "cerrada") d-none d-sm-inline-flex">
                            <span class="status-dot"></span>
                            @(cajaAbierta ? "Caja Abierta" : "Caja Cerrada")
                        </span>

                        <!-- Menú Desplegable al presionar el Usuario -->
                        <div class="dropdown">
                            <button class="user-dropdown-btn dropdown-toggle" type="button" id="globalUserDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle"></i>
                                <span>@User.Identity?.Name</span>
                                @if (!string.IsNullOrEmpty(role))
                                {
                                    <span class="user-role-tag">@role</span>
                                }
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu" aria-labelledby="globalUserDropdown">
                                <li class="user-dropdown-header">
                                    <div class="user-header-name">@User.Identity?.Name</div>
                                    <div class="user-header-role">@role</div>
                                </li>

                                <li>
                                    <a asp-controller="Menu" asp-action="Menu" class="dropdown-item">
                                        <i class="bi bi-grid-fill me-2 text-primary"></i>
                                        <span>Menú Principal</span>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>

                                @if (User.IsInRole("Administrador") || User.IsInRole("Supervisor") || User.IsInRole("Cajero"))
                                {
                                    <li>
                                        <form asp-controller="CajaDiaria" asp-action="@(cajaAbierta ? "CerrarCaja" : "AbrirCaja")" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item @(cajaAbierta ? "caja-close-item text-danger" : "caja-open-item text-warning")">
                                                <i class="bi @(cajaAbierta ? "bi-lock-fill text-danger" : "bi-unlock-fill text-warning") me-2"></i>
                                                <span>@(cajaAbierta ? "Cerrar Caja" : "Abrir Caja")</span>
                                            </button>
                                        </form>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                }

                                <li>
                                    <form asp-controller="Menu" asp-action="Logout" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item logout-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>
                                            <span>Cerrar Sesión</span>
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>

                </div>
            </nav>
        </header>
    }
    else if (!IsSectionDefined("Header"))
    {
        <header>
            <nav class="navbar navbar-expand-sm app-navbar py-2">
                <div class="container-fluid app-nav-container">
                    <a class="navbar-brand app-brand m-0" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark"><i class="bi bi-wrench-adjustable-circle-fill" aria-hidden="true"></i></span>
                        <div class="d-flex flex-column justify-content-center">
                            <span class="brand-text">Taller<span class="brand-accent">+</span></span>
                            <small class="brand-subtext">Gestión operativa</small>
                        </div>
                    </a>
                </div>
            </nav>
        </header>
    }

    @if (IsSectionDefined("Header"))
    {
        if (!showAppNavigation)
        {
            @RenderSection("Header")
        }
        else
        {
            IgnoreSection("Header");
        }
    }

    <main role="main" class="app-main @(currentController == "Login" ? "login-main" : "")">
        @RenderBody()
    </main>

    @if (IsSectionDefined("Footer"))
    {
        @RenderSection("Footer")
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@17.0.19/build/js/intlTelInput.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@17.0.19/build/js/utils.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
