@model List<dynamic>
@{
    ViewBag.Title = "Listado de Clientes";
    string filtroNombre = ViewBag.FiltroNombre as string;
    bool? filtroActivo = ViewBag.FiltroActivo as bool?;
    var clientes = Model ?? new List<dynamic>();
}

<h2>Listado de Clientes</h2>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <label class="form-label">Nombre</label>
        <input name="nombre" class="form-control" value="@filtroNombre" placeholder="Buscar por nombre" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Activo</label>
        <select name="activo" class="form-select">
            <option value="">-- Todos --</option>
            <!option value="true" @(filtroActivo == true ? "selected" : "")>Sí</!option>
            <!option value="false" @(filtroActivo == false ? "selected" : "")>No</!option>
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-primary">Filtrar</button>
    </div>
</form>

<div class="mb-3">
    <a asp-action="Crear" class="btn btn-success">Crear Nuevo Cliente</a>
</div>

<table class="table table-bordered table-hover table-sm">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Teléfono</th>
            <th class="text-end">Órdenes</th>
            <th class="text-center">Activo</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            foreach (var c in Model)
            {
                <tr ondblclick="window.location='@Url.Action("Editar","Cliente",new { id = c.IdCliente })'" style="cursor:pointer;">
                    <td>@c.IdCliente</td>
                    <td>@c.Nombre</td>
                    <td>@c.Apellido</td>
                    <td>@c.Telefono</td>
                    <td class="text-end">@c.OrdenesRealizadas</td>
                    <td class="text-center" ondblclick="event.stopPropagation();" onclick="event.stopPropagation();">
                        <form asp-action="CambiarEstado" method="post" class="d-inline" onclick="event.stopPropagation();">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idCliente" value="@c.IdCliente" />
                            <button type="submit" class="btn btn-sm p-0" onclick="event.stopPropagation();">
                                @if (c.Activo)
                                {
                                    <span class="text-success">&#10003;</span>
                                }
                                else
                                {
                                    <span class="text-danger">&#10007;</span>
                                }
                            </button>
                        </form>
                    </td>                  
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">No se encontraron clientes.</td>
            </tr>
        }
    </tbody>
</table>
