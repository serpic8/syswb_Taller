@model List<dynamic>
@{
    ViewBag.Title = "Listado de Clientes";
    bool? filtroActivo = ViewBag.FiltroActivo as bool?;
    var clientes = Model ?? new List<dynamic>();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

@section Header { }
@section Footer { }

<style>
    .filter-bar {
        background: #fff;
        padding: 1rem 1.5rem;
        border-radius: .5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }

        .filter-bar .btn-primary {
            background-color: #0097cc;
            border-color: #0097cc;
            font-weight: 600;
            transition: background-color 0.3s ease;
        }

            .filter-bar .btn-primary:hover {
                background-color: #007bb3;
                border-color: #007bb3;
            }

    .table-card {
        border-radius: .5rem;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        background: #fff;
    }

        .table-card .card-header {
            background: #0097cc;
            color: #fff;
            font-weight: 600;
            padding: 1rem 1.5rem;
            font-size: 1.25rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .table-card .card-header a.btn-success {
                font-weight: 600;
            }

        .table-card tbody tr:hover {
            background: rgba(0,151,204,0.1);
            cursor: pointer;
        }

    table.table {
        margin-bottom: 0;
    }

        table.table thead {
            background-color: #e9f2f9;
        }

        table.table th, table.table td {
            vertical-align: middle;
            padding: 0.75rem 1rem;
        }

    .text-center {
        text-align: center !important;
    }

    .text-end {
        text-align: right !important;
    }

    .btn-status {
        font-size: 1.1rem;
        width: 32px;
        height: 32px;
        line-height: 24px;
        padding: 0;
        border: none;
        background: transparent;
    }
</style>

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />

<div class="d-flex justify-content-end mb-3">
    <a asp-controller="Menu" asp-action="Menu"
       class="btn btn-outline-primary btn-lg shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-house-door-fill fs-5"></i>
        <span>Menú Principal</span>
    </a>
</div>

<div class="filter-bar row align-items-center">
    <div class="col-md-6">
        <h2 class="mb-0"><i class="bi bi-people-fill me-2"></i>Listado de Clientes</h2>
    </div>
    <form method="get" class="col-md-6 d-flex justify-content-end align-items-end" id="filtroForm">
        <div class="me-3" style="min-width: 200px;">
            <label class="form-label mb-1"><i class="bi bi-search me-1"></i>Buscar</label>
            <input type="text" id="dtSearch" class="form-control form-control-sm" placeholder="Buscar..." />
        </div>
        <div class="me-3" style="min-width: 140px;">
            <label class="form-label mb-1"><i class="bi bi-toggle2-on me-1"></i>Activo</label>
            <select class="form-select form-select-sm" name="activo">
                <option value="">-- Todos --</option>
                <!option value="true" @(filtroActivo == true ? "selected" : "")>Sí</!option>
                <!option value="false" @(filtroActivo == false ? "selected" : "")>No</!option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary btn-sm align-self-end">
            <i class="bi bi-funnel-fill me-1"></i>Filtrar
        </button>
    </form>
</div>

<div class="table-card">
    <div class="card-header">
        <span><i class="bi bi-people-fill me-2"></i>Clientes</span>
        <a asp-action="Crear" class="btn btn-sm btn-success">
            <i class="bi bi-plus-circle-fill me-1"></i> Nuevo Cliente
        </a>
    </div>
    <div class="card-body p-0">
        <table id="clientesTable" class="table table-hover mb-0 table-sm">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Teléfono</th>
                    <th class="text-end">Órdenes</th>
                    <th class="text-center">Activo</th>
                </tr>
            </thead>
            <tbody>
                @if (clientes.Any())
                {
                    foreach (var c in clientes)
                    {
                        <tr ondblclick="window.location='@Url.Action("Editar", "Cliente", new { id = c.IdCliente })'" style="cursor:pointer;">
                            <td>@c.IdCliente</td>
                            <td>@c.Nombre</td>
                            <td>@c.Apellido</td>
                            <td>@c.Telefono</td>
                            <td class="text-end">@c.OrdenesRealizadas</td>
                            <td class="text-center" onclick="event.stopPropagation();">
                                <form asp-action="CambiarEstado" method="post" class="d-inline" onsubmit="event.stopPropagation();">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idCliente" value="@c.IdCliente" />
                                    <button type="submit" class="btn-status" title="Alternar estado" onclick="event.stopPropagation();">
                                        @if (c.Activo)
                                        {
                                            <span class="text-success">&#10003;</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">&#10007;</span>
                                        }
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            <i class="bi bi-exclamation-circle me-2"></i>No se encontraron clientes.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            var table = $('#clientesTable').DataTable({
                dom: 'lrtip',
                lengthChange: false,
                pageLength: 20,
                order: [[0, 'asc']],
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Buscar...",
                    paginate: { previous: "Anterior", next: "Siguiente" }
                }
            });

            $('#dtSearch').on('input', function () {
                table.search(this.value).draw();
            });
        });
    </script>
}
