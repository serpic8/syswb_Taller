@model List<dynamic>
@using System.Globalization
@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"

@{
    ViewBag.Title = "Seleccionar Cliente";
    string filtroNombre = ViewBag.FiltroNombre as string ?? "";
    bool? filtroActivo = ViewBag.FiltroActivo as bool?;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

@section Header { }
@section Footer { }

<style>
    .filter-bar {
        background: #fff;
        padding: 1rem;
        border-radius: .5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }

        .filter-bar .btn-group a.active {
            background-color: #0097cc;
            color: #fff;
            border-color: #0097cc;
        }

    .table-card {
        border-radius: .5rem;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    }

        .table-card .card-header {
            background: #0097cc;
            color: #fff;
            font-weight: 600;
        }

        .table-card tbody tr:hover {
            background: rgba(0,151,204,0.1);
            cursor: pointer;
        }
</style>

<div class="container mt-4">
    <h2 class="mb-4"><i class="bi bi-person-check-fill me-2"></i>Seleccionar Cliente</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="filter-bar row align-items-center">
        <form method="get" class="d-flex flex-wrap align-items-end">
            <div class="me-3 mb-2">
                <label class="form-label mb-1"><i class="bi bi-search me-1"></i>Nombre</label>
                <input name="nombre" class="form-control form-control-sm" placeholder="Buscar por nombre" value="@filtroNombre" />
            </div>
            <div class="me-3 mb-2">
                <label class="form-label mb-1"><i class="bi bi-toggle2-on me-1"></i>Estado</label>
                <select name="activo" class="form-select form-select-sm">
                    <option value="">-- Todos --</option>
                    <option value="true" @(filtroActivo == true ? "selected" : "")>Activos</option>
                    <option value="false" @(filtroActivo == false ? "selected" : "")>Inactivos</option>
                </select>
            </div>
            <div class="mb-2">
                <button class="btn btn-sm btn-primary">
                    <i class="bi bi-funnel-fill me-1"></i>Filtrar
                </button>
            </div>
        </form>
    </div>

    <div class="table-card">
        <div class="card-header">
            <i class="bi bi-people-fill me-2"></i>Clientes Disponibles
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th><i class="bi bi-person-badge me-1"></i>Nombre</th>
                        <th><i class="bi bi-person me-1"></i>Apellido</th>
                        <th><i class="bi bi-telephone me-1"></i>Teléfono</th>
                        <th class="text-center"><i class="bi bi-check2-circle me-1"></i>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var c in Model)
                        {
                            <tr>
                                <td>@c.Nombre</td>
                                <td>@c.Apellido</td>
                                <td>@c.Telefono</td>
                                <td class="text-center">
                                    <a asp-controller="Vehiculo" asp-action="Crear" asp-route-idCliente="@c.IdCliente"
                                       class="btn btn-sm btn-success">
                                        <i class="bi bi-check2-circle me-1"></i>Seleccionar
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4">
                                <i class="bi bi-exclamation-circle me-2"></i>No se encontraron clientes.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
