@model dynamic

@{
    ViewBag.Title = "Editar Vehículo";
    var vh = Model;
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

@section Header { }
@section Footer { }

<style>
    body {
        background-color: #f8f9fa;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    .card-custom {
        max-width: 900px;
        margin: 2rem auto;
        padding: 2rem 3rem;
        background: #ffffff;
        border-radius: 0.75rem;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.12);
        border: none;
    }

    h2 {
        color: #004085;
        font-weight: 700;
        margin-bottom: 2rem;
        border-bottom: 3px solid #007bff;
        padding-bottom: 0.5rem;
        letter-spacing: 0.05em;
    }

    label.form-label {
        font-weight: 600;
        color: #212529;
    }

    .form-control, .form-select {
        border-radius: 0.4rem;
        border: 1.5px solid #ced4da;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: #0056b3;
            box-shadow: 0 0 5px rgba(0, 86, 179, 0.5);
            outline: none;
        }

    .btn-primary {
        background-color: #004085;
        border-color: #004085;
        font-weight: 600;
        padding: 0.55rem 1.25rem;
        transition: background-color 0.3s ease, border-color 0.3s ease;
    }

        .btn-primary:hover {
            background-color: #002752;
            border-color: #002752;
        }

    .btn-secondary {
        background-color: #6c757d;
        border-color: #6c757d;
        font-weight: 600;
        padding: 0.55rem 1.25rem;
    }

        .btn-secondary:hover {
            background-color: #565e64;
            border-color: #565e64;
        }

    .invalid-feedback {
        font-size: 0.875rem;
        color: #dc3545;
    }

    /* Select2 custom height to match bootstrap form-control */
    .select2-container .select2-selection--single {
        height: 2.5rem;
        padding: 0.375rem 0.75rem;
        border-radius: 0.4rem !important;
        border: 1.5px solid #ced4da !important;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .select2-container--default.select2-container--focus .select2-selection--single {
        border-color: #0056b3 !important;
        box-shadow: 0 0 5px rgba(0, 86, 179, 0.5);
    }

    .select2-selection__rendered {
        line-height: 1.7 !important;
        color: #212529;
    }

    .select2-selection__arrow {
        height: 2.5rem !important;
    }
</style>

<div class="card-custom shadow-sm">
    <h2><i class="bi bi-car-front-fill me-2"></i>@ViewBag.Title</h2>

    <form asp-action="Editar" method="post" id="vehiculoFormEditar" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="idVehiculo" value="@vh.IdVehiculo" />
        <input type="hidden" name="idCliente" value="@vh.IdCliente" />

        <div class="row g-4">
            <div class="col-md-4">
                <label for="vhMatricula" class="form-label">Matrícula</label>
                <input name="vhMatricula" id="vhMatricula" class="form-control" value="@vh.Matricula" required pattern="^[A-Z0-9\-]+$" />
                <div class="invalid-feedback">Ingrese una matrícula válida (solo letras, números o guiones).</div>
            </div>

            <div class="col-md-4">
                <label for="vhMarca" class="form-label">Marca</label>
                <select id="vhMarca" name="vhMarca" class="form-select" required></select>
                <div class="invalid-feedback">Debe elegir una marca válida.</div>
            </div>

            <div class="col-md-4">
                <label for="vhModelo" class="form-label">Modelo</label>
                <select id="vhModelo" name="vhModelo" class="form-select" required></select>
                <div class="invalid-feedback">Debe elegir un modelo válido.</div>
            </div>

            <div class="col-md-2">
                <label for="vhAño" class="form-label">Año</label>
                <select id="vhAño" name="vhAño" class="form-select" required></select>
                <div class="invalid-feedback">Debe elegir un año válido.</div>
            </div>

            <div class="col-md-4">
                <label for="vhColor" class="form-label">Color</label>
                <select id="vhColor" name="vhColor" class="form-select" required></select>
                <div class="invalid-feedback">Debe elegir un color válido.</div>
            </div>

            <div class="col-md-2">
                <label for="vhEstado" class="form-label">Estado</label>
                <input name="vhEstado" id="vhEstado" class="form-control" value="@vh.Estado" required readonly />
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Guardar</button>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <a asp-action="Lista" asp-route-id="@vh.IdCliente" class="btn btn-secondary w-100">Cancelar</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const marcaSel = $('#vhMarca');
            const modeloSel = $('#vhModelo');
            const añoSel = $('#vhAño');
            const colorSel = $('#vhColor');
            const form = document.getElementById("vehiculoFormEditar");

            const colores = [
                { id: "Rojo", text: "Rojo", color: "#FF0000" },
                { id: "Verde", text: "Verde", color: "#00FF00" },
                { id: "Azul", text: "Azul", color: "#0000FF" },
                { id: "Amarillo", text: "Amarillo", color: "#FFFF00" },
                { id: "Negro", text: "Negro", color: "#000000" },
                { id: "Blanco", text: "Blanco", color: "#FFFFFF" },
                { id: "Gris", text: "Gris", color: "#808080" },
                { id: "Naranja", text: "Naranja", color: "#FFA500" },
                { id: "Morado", text: "Morado", color: "#800080" },
                { id: "Celeste", text: "Celeste", color: "#87CEEB" },
                { id: "Rosa", text: "Rosa", color: "#FFC0CB" },
                { id: "Marrón", text: "Marrón", color: "#A52A2A" },
                { id: "Dorado", text: "Dorado", color: "#FFD700" },
                { id: "Plata", text: "Plata", color: "#C0C0C0" }
            ];

            function formatColorOption(state) {
                if (!state.id) return state.text;
                const color = colores.find(c => c.text === state.text);
                if (!color) return state.text;

                const $colorBox = $(
                    `<span style="display:inline-block;width:16px;height:16px;margin-right:8px;vertical-align:middle;
                                    background-color:${color.color};border:1px solid #ccc;"></span>`
                );
                const $container = $('<span></span>');
                $container.append($colorBox);
                $container.append(state.text);
                return $container;
            }

            marcaSel.select2({ placeholder: "-- Seleccione Marca --", width: '100%' });
            modeloSel.select2({ placeholder: "-- Seleccione Modelo --", width: '100%' });
            añoSel.select2({ placeholder: "-- Seleccione Año --", width: '100%' });
            colorSel.select2({
                placeholder: "-- Seleccione Color --",
                data: colores,
                templateResult: formatColorOption,
                templateSelection: formatColorOption,
                escapeMarkup: m => m,
                width: '100%'
            });

            axios.get("https://vpic.nhtsa.dot.gov/api/vehicles/getallmakes?format=json")
                .then(res => {
                    const marcas = res.data.Results;
                    marcas.sort((a, b) => a.Make_Name.localeCompare(b.Make_Name));
                    marcas.forEach(m => {
                        const option = new Option(m.Make_Name, m.Make_Name, false, m.Make_Name === "@vh.Marca");
                        marcaSel.append(option);
                    });
                    marcaSel.trigger('change');
                })
                .catch(() => alert("Error cargando marcas"));

            function loadModelos(marca, modeloActual) {
                modeloSel.prop("disabled", true).empty().append(new Option());
                añoSel.prop("disabled", true).empty().append(new Option());
                if (!marca) return;

                axios.get(`https://vpic.nhtsa.dot.gov/api/vehicles/GetModelsForMake/${encodeURIComponent(marca)}?format=json`)
                    .then(res => {
                        const modelos = res.data.Results;
                        modelos.sort((a, b) => a.Model_Name.localeCompare(b.Model_Name));
                        modelos.forEach(m => {
                            const selected = m.Model_Name === modeloActual;
                            modeloSel.append(new Option(m.Model_Name, m.Model_Name, selected, selected));
                        });
                        modeloSel.prop("disabled", false);
                        modeloSel.trigger('change');
                    })
                    .catch(() => alert("Error cargando modelos"));
            }

            marcaSel.on("change", function () {
                loadModelos(this.value, null);
            });

            modeloSel.on("change", function () {
                const modelo = this.value;
                añoSel.prop("disabled", true).empty().append(new Option());
                if (!modelo) return;

                for (let y = 2025; y >= 1995; y--) {
                    const selected = y.toString() === "@vh.Año";
                    añoSel.append(new Option(y, y, selected, selected));
                }
                añoSel.prop("disabled", false);
            });

            if ("@vh.Marca") {
                loadModelos("@vh.Marca", "@vh.Modelo");
                setTimeout(() => {
                    añoSel.val("@vh.Año").trigger('change');
                }, 500);
            }

            if ("@vh.Color") {
                colorSel.val("@vh.Color").trigger('change');
            }

            form.addEventListener("submit", e => {
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                form.classList.add("was-validated");
            });
        });
    </script>
}
