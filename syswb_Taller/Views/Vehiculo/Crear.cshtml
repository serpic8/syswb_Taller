@model dynamic
@{
    ViewBag.Title = "Crear Vehículo";
    int idCliente = ViewBag.IdCliente;
}

<h2>Crear Vehículo para Cliente #@idCliente</h2>

<form asp-action="Crear" method="post" class="mb-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="idCliente" value="@idCliente" />

    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Matrícula</label>
            <input name="vhMatricula" class="form-control" required />
        </div>
        <div class="col-md-4">
            <label class="form-label">Marca</label>
            <input name="vhMarca" class="form-control" required />
        </div>
        <div class="col-md-4">
            <label class="form-label">Modelo</label>
            <input name="vhModelo" class="form-control" required />
        </div>
        <div class="col-md-2">
            <label class="form-label">Año</label>
            <input name="vhAño" type="number" class="form-control" required />
        </div>
        <div class="col-md-3">
            <label class="form-label">Color</label>
            <input name="vhColor" class="form-control" required />
        </div>
        <div class="col-md-3">
            <label class="form-label">Estado</label>
            <input name="vhEstado" class="form-control" required />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-success">Guardar Vehículo</button>
            <a asp-controller="Vehiculo" asp-action="Lista" asp-route-id="@idCliente" class="btn btn-secondary ms-2">Volver</a>
        </div>
    </div>
</form>
