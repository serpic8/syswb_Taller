    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List<syswb_Taller.Models.Persona>;
<div class="row">
    <div class="col-sm-8 offset-sm-2">
        <h2>lista Persona</h2>
        @* boton que aparezca en form lista para ir a nuevo o agregar *@
        <a asp-controller="Persona" asp-action="Nuevo" class="btn btn-success mb-3">Nuevo</a>
        <table class="col-sm-8 offset-sm-2">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Telefono</th>
                    <th>Cedula</th>

                </tr>

            </thead>
            <tbody>
                @foreach (var item in Model) @*Aca podria o crear una vista o un metodo get que llame a lo que quiero*@
                {
                    <tr>
                        <td>@item.IdPersona</td>
                        <td>@item.PNombre</td>
                        <td>@item.PApellido</td>
                        <td>@item.PTelefono</td>
                        <td>@item.PCedula</td>
                        <td>
                            <a 
                                asp-controller="Persona" 
                                asp-action="Editar"
                                asp-route-id="@item.IdPersona"
                                class="btn btn-primary">
                                Editar

                            </a>@*route-"id" aca es donde se llama al id, lo tomamos de aca para utilizar los metodos *@
                            <a asp-controller="Persona"
                               asp-action="Eliminar"
                               asp-route-id="@item.IdPersona" 
                               onclick="return confirmar()"
                               class="btn btn-danger">
                                Eliminar

                            </a>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

@section Scripts{  @* Esta es la validacion de eliminar persona *@
    <script>
        function confirmar() {
            return confirm("Esta seguro de eliminar el empleado?")
        }
    </script>
}
