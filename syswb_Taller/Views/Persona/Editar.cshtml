@{
}
@model syswb_Taller.Models.Persona
<div class="row">
    <div class="col-sm-8 offset-sm-2">
        <h2>Editar Persona</h2>
        <form asp-controller="Persona" asp-action="Editar" method="post">
            <input asp-for="IdPersona" type="hidden"/>
            @* esto es para que se conecte al metodo post que agrega la info *@
            @* esto son los textbox *@
            <div class="mb-3">
                <label>Nombre</label>
                <input class="form-control" asp-for="PNombre" type="text"></input>
            </div>
            <div class="mb-3">
                <label>Apellido</label>
                <input class="form-control" asp-for="PApellido" type="text"></input>
            </div>
            <div class="mb-3">
                <label>Telefono</label>
                <input class="form-control" asp-for="PTelefono" type="text"></input>
            </div>
            <div class="mb-3">
                <label>Cedula</label>
                <input class="form-control" asp-for="PCedula" type="text"></input>
            </div>
            @*  aca viene el boton *@
            <div class="mb-3">
                <button class="btn btn-primary" type="submit">Guardar</button>
                @* esto es para redirigir a la lista *@
                <a asp-controller="Persona" asp-action="Lista" class="btn btn-warning">Volver</a>
            </div>

        </form>

    </div>
</div>
