@model System.Data.DataTable

@{
    ViewBag.Title = "Historial de Movimientos del Producto";
    var idProducto = ViewBag.IdProducto;
    // Si más adelante cargas el nombre en el ViewBag:
    var nombreProducto = ViewBag.PrNombre as string ?? $"#{idProducto}";
}

@section Header { }
@section Footer { }

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        .btn-group a span {
            font-size: 1rem;
        }

        .table th, .table td {
            vertical-align: middle;
        }

        .table thead th {
            text-align: center;
        }

        .btn-group a {
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

        .table-icon {
            margin-right: 5px;
            color: #0d6efd;
        }
    </style>
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <i class="bi bi-clock-history fs-3 me-2"></i>
            <h2 class="mb-0">Historial de Movimientos de @nombreProducto</h2>
        </div>
        <div class="card-body">
            <div class="btn-group mb-4" role="group" aria-label="Opciones Producto">
                <a href="@Url.Action("Editar","Producto", new { id = idProducto })" class="btn btn-outline-info shadow-sm">
                    <i class="bi bi-card-list fs-5"></i> <span>Detalle Producto</span>
                </a>
                <a href="@Url.Action("IncrementarStock","Producto", new { id = idProducto })" class="btn btn-outline-info shadow-sm">
                    <i class="bi bi-box-seam fs-5"></i> <span>Stock</span>
                </a>
                @* Ya estamos en Historial, así que no es necesario el link activo *@
            </div>

            @if (Model?.Rows.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th class="text-center"><i class="bi bi-calendar-event table-icon"></i>Fecha y Hora</th>
                                <th class="text-center"><i class="bi bi-arrows-move table-icon"></i>Tipo</th>
                                <th class="text-end"><i class="bi bi-plus-slash-minus table-icon"></i>Modificación</th>
                                <th class="text-end"><i class="bi bi-boxes table-icon"></i>Stock Resultante</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (System.Data.DataRow row in Model.Rows)
                            {
                                var mod = Convert.ToInt32(row["Modificacion"]);
                                <tr>
                                    <td class="text-center">
                                        @(row["FechaHora"] is DateTime dt
                                            ? dt.ToString("g")
                                            : row["FechaHora"].ToString())
                                    </td>
                                    <td class="text-center">@row["Tipo"]</td>
                                    <td class="text-end @(mod < 0 ? "text-danger" : "text-success")">
                                        @mod
                                    </td>
                                    <td class="text-end fw-bold">@row["StockResultante"]</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-4 text-warning"></i>
                    <span>No hay movimientos registrados para este producto.</span>
                </div>
            }

            <a asp-action="DetalleProducto" asp-route-id="@idProducto" class="btn btn-outline-secondary mt-3 d-flex align-items-center gap-2">
                <i class="bi bi-arrow-left-circle fs-5"></i> <span>Volver al producto</span>
            </a>
        </div>
    </div>
</div>
