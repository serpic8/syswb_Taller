@model System.Data.DataTable

<h2>Historial de movimientos del producto</h2>



@if (Model?.Rows.Count > 0)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Fecha y Hora</th>
                <th>Tipo</th>
                <th>Modificación</th>
                <th>Stock Resultante</th>
            </tr>
        </thead>
        <tbody>
            @foreach (System.Data.DataRow row in Model.Rows)
            {
                <tr>
                    <td>@((DateTime)row["FechaHora"])</td>
                    <td>@row["Tipo"]</td>
                    <td>@string.Format("{0:N2}", row["Modificación"])</td>
                    <td>@row["StockResultante"]</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No hay movimientos para el producto seleccionado.</p>
}
