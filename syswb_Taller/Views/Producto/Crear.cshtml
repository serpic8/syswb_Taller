@model syswb_Taller.Models.ProductoRepuesto
@{
    ViewBag.Title = "Crear Producto";
}

<h2>Crear Producto</h2>

<form asp-action="Crear" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input name="prNombre" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Marca</label>
        <input name="prMarca" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Categoría</label>
        <input name="prCategoria" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Costo</label>
        <input name="prCosto" type="number" step="0.01" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Precio Venta</label>
        <input name="prPrecioVenta" type="number" step="0.01" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Lista" class="btn btn-secondary ms-2">Cancelar</a>
</form>
