@model syswb_Taller.Models.ProductoRepuesto
@{
    ViewBag.Title = "Editar Producto";
}

@if (TempData["SuccessMessage"] != null)
{
    <script>alert("@TempData["SuccessMessage"]");</script>
}

@section Header { }
@section Footer { }

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        .select2-container .select2-selection--single {
            height: 48px;
            padding: 8px 12px;
            font-size: 1.1rem;
        }
        /* Validación estilos */
        .is-invalid {
            border-color: #dc3545 !important;
        }
        .form-text.text-danger {
            font-size: 0.875rem;
        }
    </style>
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <i class="bi bi-pencil-square fs-3 me-2"></i>
            <h2 class="mb-0">Editar Producto</h2>
        </div>
        <div class="card-body">
            <div class="btn-group mb-4" role="group" aria-label="Opciones Producto">
                <a href="@Url.Action("Editar","Producto", new { id = Model.IdProducto })" class="btn btn-outline-primary">
                    <i class="bi bi-card-list me-1"></i> Detalle Producto
                </a>
                <a href="@Url.Action("IncrementarStock","Producto", new { id = Model.IdProducto })" class="btn btn-outline-info">
                    <i class="bi bi-box-seam me-1"></i> Stock
                </a>
                <a href="@Url.Action("HistorialProducto", "Producto", new { idProducto = Model.IdProducto })"
                   class="btn btn-outline-info d-flex align-items-center gap-2 shadow-sm">
                    <i class="bi bi-clock-history fs-5"></i>
                    <span>Ver Historial</span>
                </a>
            </div>

            <form asp-action="Editar" method="post" id="productoForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.IdProducto" />

                <div class="mb-4">
                    <label for="prNombre" class="form-label fw-semibold">
                        <i class="bi bi-card-text me-1"></i> Nombre del Producto
                    </label>
                    <input type="text"
                           id="prNombre"
                           name="prNombre"
                           value="@Model.PrNombre"
                           class="form-control form-control-lg"
                           required />
                </div>

                <div class="mb-4">
                    <label for="prMarca" class="form-label fw-semibold">
                        <i class="bi bi-tags me-1"></i> Marca
                    </label>
                    <select id="prMarca" name="prMarca" class="form-select form-select-lg select2" data-placeholder="Seleccione o escriba una marca" >
                        <option></option>
                        @if (ViewBag.Marcas is IEnumerable<string> marcas)
                        {
                            foreach (string m in marcas)
                            {
                                <!option value="@m" @(Model.PrMarca == m ? "selected" : "")>@m</!option>
                            }
                        }
                        else
                        {
                            <option selected>@Model.PrMarca</option>
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <label for="prCategoria" class="form-label fw-semibold">
                        <i class="bi bi-grid-3x3-gap me-1"></i> Categoría
                    </label>
                    <select id="prCategoria" name="prCategoria" class="form-select form-select-lg select2" data-placeholder="Seleccione o escriba una categoría">
                        <option></option>
                        @if (ViewBag.Categorias is IEnumerable<string> categorias)
                        {
                            foreach (string c in categorias)
                            {
                                <!option value="@c" @(Model.PrCategoria == c ? "selected" : "")>@c</!option>
                            }
                        }
                        else
                        {
                            <option selected>@Model.PrCategoria</option>
                        }
                    </select>
                </div>

                <div class="mb-4">
                    <label for="prCosto" class="form-label fw-semibold">
                        <i class="bi bi-currency-exchange me-1"></i> Costo
                    </label>
                    <input type="text"
                           id="prCosto"
                           name="prCosto"
                           class="form-control form-control-lg"
                           value="@Model.PrCosto"
                           required />
                    <div class="form-text text-danger mt-2 d-none" id="costoError" role="alert" aria-live="assertive">
                        Costo inválido. Solo números positivos y punto decimal permitidos.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="prPrecioVenta" class="form-label fw-semibold">
                        <i class="bi bi-cash-coin me-1"></i> Precio Venta
                    </label>
                    <input type="text"
                           id="prPrecioVenta"
                           name="prPrecioVenta"
                           class="form-control form-control-lg"
                           value="@Model.PrPrecioVenta"
                           required />
                    <div class="form-text text-danger mt-2 d-none" id="precioError" role="alert" aria-live="assertive">
                        Precio inválido. Solo números positivos y punto decimal permitidos.
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                        <i class="bi bi-save2 me-2"></i> Guardar Cambios
                    </button>
                    <a asp-action="Lista" class="btn btn-outline-secondary btn-lg flex-grow-1">
                        <i class="bi bi-x-circle me-2"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            $('.select2').select2({
                tags: true,
                width: '100%',
                placeholder: function () {
                    return $(this).data('placeholder');
                }
            });

            const form = document.getElementById("productoForm");
            const costoInput = document.getElementById("prCosto");
            const precioInput = document.getElementById("prPrecioVenta");
            const costoError = document.getElementById("costoError");
            const precioError = document.getElementById("precioError");

            function validarCampoDecimal(input, errorDiv) {
                const valor = input.value.trim();
                const regex = /^[0-9]+(\.[0-9]{1,2})?$/;
                if (!regex.test(valor) || parseFloat(valor) < 0) {
                    input.classList.add("is-invalid");
                    errorDiv.classList.remove("d-none");
                    return false;
                }
                input.classList.remove("is-invalid");
                errorDiv.classList.add("d-none");
                return true;
            }

            costoInput.addEventListener("input", () => validarCampoDecimal(costoInput, costoError));
            costoInput.addEventListener("blur", () => validarCampoDecimal(costoInput, costoError));
            precioInput.addEventListener("input", () => validarCampoDecimal(precioInput, precioError));
            precioInput.addEventListener("blur", () => validarCampoDecimal(precioInput, precioError));

            form.addEventListener("submit", function (e) {
                const validoCosto = validarCampoDecimal(costoInput, costoError);
                const validoPrecio = validarCampoDecimal(precioInput, precioError);

                if (!form.checkValidity() || !validoCosto || !validoPrecio) {
                    e.preventDefault();
                    e.stopPropagation();
                }

                form.classList.add("was-validated");
            });
        });
    </script>
}
