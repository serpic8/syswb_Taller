@model syswb_Taller.Models.ProductoRepuesto

@{
    ViewBag.Title = "Incrementar Stock";
    var proveedores = ViewBag.Proveedores as List<dynamic> ?? new List<dynamic>();
    var ultimasCompras = ViewBag.UltimasCompras as List<dynamic> ?? new List<dynamic>();
}

@if (TempData["SuccessMessage"] != null)
{
    <script>alert("@TempData["SuccessMessage"]");</script>
}

@section Header { }
@section Footer { }

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        .select2-container .select2-selection--single {
            height: 48px;
            padding: 8px 12px;
            font-size: 1.1rem;
        }
        /* Validación estilos */
        .is-invalid {
            border-color: #dc3545 !important;
        }

        .form-text.text-danger {
            font-size: 0.875rem;
        }
    </style>
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex align-items-center">
            <i class="bi bi-box-seam fs-3 me-2"></i>
            <h2 class="mb-0">Incrementar Stock de @Model.PrNombre</h2>
        </div>
        <div class="card-body">
            <div class="btn-group mb-4" role="group" aria-label="Opciones Producto">
                <a href="@Url.Action("Editar","Producto", new { id = Model.IdProducto })" class="btn btn-outline-secondary">
                    <i class="bi bi-card-list me-1"></i> Detalle Producto
                </a>
                <a href="@Url.Action("IncrementarStock","Producto", new { id = Model.IdProducto })" class="btn btn-outline-primary">
                    <i class="bi bi-box-seam me-1"></i> Stock
                </a>
                <a href="@Url.Action("HistorialProducto", "Producto", new { idProducto = Model.IdProducto })"
                   class="btn btn-outline-info d-flex align-items-center gap-2 shadow-sm">
                    <i class="bi bi-clock-history fs-5"></i>
                    <span>Ver Historial</span>
                </a>

            </div>

            <form asp-action="IncrementarStock" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input name="IdProducto" type="hidden" value="@Model.IdProducto" />

                <div class="mb-4">
                    <label for="Cantidad" class="form-label fw-semibold">
                        <i class="bi bi-plus-circle me-1"></i> Cantidad
                    </label>
                    <div class="input-group input-group-lg">
                        <button type="button" id="decrementBtn" class="btn btn-outline-secondary">
                            <i class="bi bi-dash"></i>
                        </button>
                        <input id="Cantidad" name="Cantidad" type="number" class="form-control" min="1" value="1" required />
                        <button type="button" id="incrementBtn" class="btn btn-outline-secondary">
                            <i class="bi bi-plus"></i>
                        </button>
                    </div>
                    <div class="form-text text-danger mt-2 d-none" id="cantidadError" role="alert" aria-live="assertive">
                        La cantidad debe ser un número entero mayor o igual a 1.
                    </div>
                </div>

                <div class="mb-4">
                    <label for="IdProveedor" class="form-label fw-semibold">
                        <i class="bi bi-truck me-1"></i> Proveedor (opcional)
                    </label>
                    <select id="IdProveedor" name="IdProveedor" class="form-select form-select-lg select2" data-placeholder="Seleccione un proveedor">
                        <option value="">-- Sin proveedor --</option>
                        @foreach (var prov in proveedores)
                        {
                            <option value="@prov.IdProveedor">@prov.PNombre - @prov.PrecioReferencia.ToString("C2")</option>
                        }
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-lg flex-grow-1">
                        <i class="bi bi-plus-lg me-2"></i> Agregar
                    </button>
                    <a asp-action="Lista" class="btn btn-outline-secondary btn-lg flex-grow-1">
                        <i class="bi bi-x-circle me-2"></i> Cancelar
                    </a>
                </div>
            </form>

            <h3 class="mt-5">Últimas Compras</h3>
            <div class="list-group">
                @if (ultimasCompras.Any(c => c.CprActivo))
                {
                    foreach (var compra in ultimasCompras.Where(c => c.CprActivo))
                    {
                        <a class="list-group-item list-group-item-action delete-item" data-id="@compra.IdCompra" style="cursor:pointer;">
                            <div class="d-flex w-100 justify-content-between">
                                <h5 class="mb-1">Compra #@compra.IdCompra</h5>
                                <small>@compra.CompFecha</small>
                            </div>
                            <p class="mb-1">Cantidad: @compra.CproCantidad</p>
                            <small>Proveedor: @(compra.IdProveedor != null ? compra.ProveedorNombre : "N/A")</small>
                        </a>
                    }
                }
                else
                {
                    <div class="list-group-item">No hay compras recientes.</div>
                }
            </div>

            @* Formularios ocultos para eliminación *@
            @foreach (var compra in ultimasCompras)
            {
                <form id="delForm_@compra.IdCompra"
                      asp-controller="Producto"
                      asp-action="Eliminar"
                      method="post"
                      style="display:none">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@compra.IdCompra" />
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            $('.select2').select2({
                tags: false,
                width: '100%',
                placeholder: function () {
                    return $(this).data('placeholder');
                }
            });

            const form = document.querySelector("form[asp-action='IncrementarStock']");
            const cantidadInput = document.getElementById("Cantidad");
            const cantidadError = document.getElementById("cantidadError");

            function validarCantidad() {
                const val = cantidadInput.value.trim();
                const num = parseInt(val, 10);
                if (!val || isNaN(num) || num < 1) {
                    cantidadInput.classList.add("is-invalid");
                    cantidadError.classList.remove("d-none");
                    return false;
                }
                cantidadInput.classList.remove("is-invalid");
                cantidadError.classList.add("d-none");
                return true;
            }

            document.getElementById('decrementBtn').addEventListener('click', function () {
                let qty = parseInt(cantidadInput.value) || 1;
                if (qty > 1) cantidadInput.value = qty - 1;
                validarCantidad();
            });

            document.getElementById('incrementBtn').addEventListener('click', function () {
                let qty = parseInt(cantidadInput.value) || 1;
                cantidadInput.value = qty + 1;
                validarCantidad();
            });

            cantidadInput.addEventListener('input', validarCantidad);
            cantidadInput.addEventListener('blur', validarCantidad);

            form.addEventListener("submit", function (e) {
                if (!validarCantidad() || !form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                form.classList.add("was-validated");
            });

            // Doble click para eliminar compra
            document.querySelectorAll('.delete-item').forEach(function (item) {
                item.addEventListener('dblclick', function () {
                    var id = item.getAttribute('data-id');
                    if (confirm('¿Está Seguro de devolver?')) {
                        document.getElementById('delForm_' + id).submit();
                    }
                });
            });
        });
    </script>
}
