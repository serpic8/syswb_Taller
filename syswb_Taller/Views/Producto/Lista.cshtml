@model List<syswb_Taller.Models.ProductoRepuesto>
@{
    ViewBag.Title = "Productos";
    string marca = ViewBag.FiltroMarca as string ?? "";
    string categoria = ViewBag.FiltroCategoria as string ?? "";
    bool? activo = ViewBag.FiltroActivo as bool?;
    var list = Model ?? new List<syswb_Taller.Models.ProductoRepuesto>();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

@section Header { }
@section Footer { }

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
    <style>
        .filter-bar {
            background: #fff;
            padding: 1rem;
            border-radius: .5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            margin-bottom: 2rem;
        }

        .table-card {
            border-radius: .5rem;
            overflow: hidden;
            box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        }

            .table-card .card-header {
                background: #0097cc;
                color: #fff;
                font-weight: 600;
                padding: 1rem 1.25rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .table-card .card-body {
                padding: 0;
            }

            .table-card table tr:hover {
                background-color: rgba(0,151,204,0.05);
                cursor: pointer;
            }

        .table th, .table td {
            vertical-align: middle;
        }
    </style>
}

<div class="d-flex justify-content-end mb-3">
    <a asp-controller="Menu" asp-action="Menu"
       class="btn btn-outline-primary btn-lg shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-house-door-fill fs-5"></i>
        <span>Menú Principal</span>
    </a>
</div>

<form method="get" asp-action="Lista" class="filter-bar row g-3 align-items-end">
    <div class="col-md-3">
        <label class="form-label"><i class="bi bi-search me-1"></i>Buscar</label>
        <input type="text" id="dtSearch" class="form-control form-control-sm" placeholder="Buscar..." />
    </div>
    <div class="col-md-3">
        <label class="form-label"><i class="bi bi-tags me-1"></i>Marca</label>
        <input name="marca" class="form-control form-control-sm" value="@marca" />
    </div>
    <div class="col-md-3">
        <label class="form-label"><i class="bi bi-grid-3x3-gap me-1"></i>Categoría</label>
        <input name="categoria" class="form-control form-control-sm" value="@categoria" />
    </div>
    <div class="col-md-2">
        <label class="form-label"><i class="bi bi-toggle2-on me-1"></i>Activo</label>
        <select name="activo" class="form-select form-select-sm">
            <option value="">-- Todos --</option>
            <!option value="true" @(activo == true ? "selected" : "")>Sí</!option>
            <!option value="false" @(activo == false ? "selected" : "")>No</!option>
        </select>
    </div>
    <div class="col-md-1">
        <button class="btn btn-sm btn-primary w-100">
            <i class="bi bi-funnel-fill me-1"></i>Filtrar
        </button>
    </div>
</form>

<div class="table-card">
    <div class="card-header">
        <span><i class="bi bi-box-seam me-2"></i>Lista de Productos</span>
        <a asp-action="Crear" class="btn btn-sm btn-success">
            <i class="bi bi-plus-circle-fill me-1"></i>Nuevo Producto
        </a>
    </div>
    <div class="card-body">
        <table id="productosTable" class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th><i class="bi bi-hash me-1"></i>ID</th>
                    <th><i class="bi bi-card-text me-1"></i>Nombre</th>
                    <th><i class="bi bi-tags me-1"></i>Marca</th>
                    <th><i class="bi bi-grid-3x3-gap me-1"></i>Categoría</th>
                    <th class="text-end"><i class="bi bi-currency-dollar me-1"></i>Costo</th>
                    <th class="text-end"><i class="bi bi-cash-coin me-1"></i>Precio Venta</th>
                    <th class="text-end"><i class="bi bi-boxes me-1"></i>Stock</th>
                    <th class="text-center"><i class="bi bi-check-circle me-1"></i>Activo</th>
                    <th class="text-end">Acción</th>
                </tr>
            </thead>
            <tbody>
                @if (list.Any())
                {
                    foreach (var p in list)
                    {
                        <tr ondblclick="window.location='@Url.Action("Editar", "Producto", new { id = p.IdProducto })'">
                            <td>@p.IdProducto</td>
                            <td>@p.PrNombre</td>
                            <td>@p.PrMarca</td>
                            <td>@p.PrCategoria</td>
                            <td class="text-end">@((p.PrCosto ?? 0).ToString("C"))</td>
                            <td class="text-end">@((p.PrPrecioVenta ?? 0).ToString("C"))</td>
                            <td class="text-end">@p.PrStock</td>
                            <td class="text-center" onclick="event.stopPropagation();">
                                <form asp-action="Toggle" method="post" class="d-inline" onsubmit="event.stopPropagation();">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.IdProducto" />
                                    <button type="submit" class="btn btn-sm p-0 text-center" title="Alternar estado">
                                        @if (p.PrActivo)
                                        {
                                            <i class="bi bi-check-lg text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-x-lg text-danger"></i>
                                        }
                                    </button>
                                </form>
                            </td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@p.IdProducto"><i class="bi bi-pencil-square me-1" aria-hidden="true"></i>Editar</a></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-4">
                            <i class="bi bi-exclamation-circle me-2"></i>No se encontraron productos.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            var table = $('#productosTable').DataTable({
                dom: 'lrtip',            // oculta buscador interno
                lengthChange: false,
                pageLength: 20,
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Buscar...",
                    paginate: { previous: "Anterior", next: "Siguiente" }
                },
                order: [[0, 'asc']],
                columnDefs: [{ orderable: true, targets: '_all' }]
            });

            // conectar buscador externo
            $('#dtSearch').on('input', function () {
                table.search(this.value).draw();
            });
        });
    </script>
}
