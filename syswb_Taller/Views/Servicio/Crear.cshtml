@{
    ViewBag.Title = "Crear Servicio";
}

<h2>Crear Servicio</h2>

<form asp-action="Crear" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input name="serNombre" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Precio Unitario</label>
        <input name="serPrecioUnit" type="number" step="0.01" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Lista" class="btn btn-secondary ms-2">Cancelar</a>
</form>
