@model List<syswb_Taller.Models.Servicio>
@using System.Globalization
@removeTagHelper "Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper, Microsoft.AspNetCore.Mvc.TagHelpers"
@{
    ViewData["Title"] = "Servicios";
    string nombre = ViewBag.FiltroNombre as string ?? "";
    bool? activo = ViewBag.FiltroActivo as bool?;
    var servicios = Model;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

@section Header { }
@section Footer { }

<style>
    .filter-bar {
        background: #fff;
        padding: 1rem;
        border-radius: .5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }

        .filter-bar .btn-group a.active {
            background-color: #0097cc;
            color: #fff;
            border-color: #0097cc;
        }

    .table-card {
        border-radius: .5rem;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    }

        .table-card .card-header {
            background: #0097cc;
            color: #fff;
            font-weight: 600;
        }

        .table-card tbody tr:hover {
            background: rgba(0,151,204,0.1);
            cursor: pointer;
        }
</style>


<div class="d-flex justify-content-end mb-3">
    <a asp-controller="Menu" asp-action="Menu"
       class="btn btn-outline-primary btn-lg shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-house-door-fill fs-5"></i>
        <span>Menú Principal</span>
    </a>
</div>

<div class="filter-bar row align-items-center">
    <!-- Columna izquierda: Título -->
    <div class="col-md-6">
        <h2 class="mb-0"><i class="bi bi-gear-fill me-2"></i>Servicios</h2>
    </div>
    <!-- Columna derecha: Formulario de filtros -->
    <form method="get" class="col-md-6 d-flex justify-content-end align-items-end" id="filtroForm">
        <div class="me-3">
            <label class="form-label mb-1">
                <i class="bi bi-search me-1"></i>Nombre
            </label>
            <input type="text" class="form-control form-control-sm" name="nombre" placeholder="Buscar..." value="@ViewBag.NombreFiltro" />
        </div>
        <div class="me-3">
            <label class="form-label mb-1">
                <i class="bi bi-toggle2-on me-1"></i>Estado
            </label>
            <select class="form-select form-select-sm" name="activo">
                <option value="">-- Todos --</option>
                <option value="true" @(ViewBag.ActivoFiltro == true ? "selected" : "")>Activo</option>
                <option value="false" @(ViewBag.ActivoFiltro == false ? "selected" : "")>Inactivo</option>
            </select>
        </div>
        <button type="submit" class="btn btn-sm btn-primary align-self-end">
            <i class="bi bi-funnel-fill me-1"></i> Filtrar
        </button>
    </form>
</div>



<div class="table-card">
    <div class="card-header">
        <i class="bi bi-gear-fill me-2"></i> Lista de Servicios
        <a asp-action="Crear" class="btn btn-sm btn-success float-end">
            <i class="bi bi-plus-circle-fill me-1"></i> Nuevo
        </a>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th><i class="bi bi-hash me-1"></i>ID</th>
                    <th><i class="bi bi-card-text me-1"></i>Nombre</th>
                    <th class="text-end"><i class="bi bi-currency-dollar me-1"></i>Precio Unitario</th>
                    <th class="text-center"><i class="bi bi-check-circle me-1"></i>Activo</th>
                </tr>
            </thead>
            <tbody>
                @if (servicios.Any())
                {
                    foreach (var s in servicios)
                    {
                        <tr ondblclick="window.location='@Url.Action("Editar", "Servicio", new { id = s.IdServicio })'">
                            <td>@s.IdServicio</td>
                            <td>@s.SerNombre</td>
                            <td class="text-end">@s.SerPrecioUnit.ToString("C", CultureInfo.CurrentCulture)</td>
                            <td class="text-center align-middle" onclick="event.stopPropagation();">
                                <form asp-action="CambiarEstado" method="post" class="d-inline-block" onsubmit="event.stopPropagation();">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="idServicio" value="@s.IdServicio" />
                                    <button type="submit" class="toggle-btn btn btn-sm d-flex justify-content-center align-items-center @(s.SerActivo ? "text-success" : "text-danger")" title="Alternar estado" style="width: 32px; height: 32px;">
                                        <i class="bi @(s.SerActivo ? "bi-check-lg" : "bi-x-lg")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center py-4">
                            <i class="bi bi-exclamation-circle me-2"></i>No se encontraron servicios.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
