@{
    ViewBag.Title = "Editar Servicio";
    var servicio = ViewBag.Servicio;
}

@if (TempData["SuccessMessage"] != null)
{
    <script>alert("@TempData["SuccessMessage"]");</script>
}

@section Header { }
@section Footer { }

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark">
            <h2 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Editar Servicio</h2>
        </div>
        <div class="card-body">
            <form asp-action="Editar" method="post" id="editarServicioForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="idServicio" value="@servicio.IdServicio" />

                <div class="mb-4">
                    <label for="serNombre" class="form-label fw-semibold">
                        <i class="bi bi-card-text me-1"></i>Nombre del Servicio
                    </label>
                    <input type="text"
                           id="serNombre"
                           name="serNombre"
                           value="@servicio.SerNombre"
                           class="form-control form-control-lg"
                           placeholder="Ej: Mantenimiento General"
                           required />
                </div>

                <div class="mb-4">
                    <label for="serPrecioUnit" class="form-label fw-semibold">
                        <i class="bi bi-currency-dollar me-1"></i>Precio Unitario
                    </label>
                    <input type="text"
                           id="serPrecioUnit"
                           name="serPrecioUnit"
                           value="@servicio.SerPrecioUnit"
                           class="form-control form-control-lg"
                           placeholder="Ej: 1500.00"
                           required />

                    <div class="form-text text-danger mt-2 d-none" id="precioError" role="alert" aria-live="assertive">
                        Precio inválido. Solo números positivos y punto decimal permitidos.
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success btn-lg flex-grow-1">
                        <i class="bi bi-save2 me-2"></i>Guardar Cambios
                    </button>
                    <a href="@Url.Action("Lista", "Servicio")" class="btn btn-outline-secondary btn-lg flex-grow-1 text-center">
                        <i class="bi bi-x-circle me-2"></i>Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("editarServicioForm");
            const precioInput = document.getElementById("serPrecioUnit");
            const precioError = document.getElementById("precioError");

            function validarPrecio() {
                const valor = precioInput.value.trim();
                const regex = /^[0-9]+(\.[0-9]{1,2})?$/;
                if (!regex.test(valor) || parseFloat(valor) < 0) {
                    precioError.classList.remove("d-none");
                    return false;
                }
                precioError.classList.add("d-none");
                return true;
            }

            precioInput.addEventListener("input", validarPrecio);
            precioInput.addEventListener("blur", validarPrecio);

            form.addEventListener("submit", function (e) {
                if (!form.checkValidity() || !validarPrecio()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                form.classList.add("was-validated");
            });
        });
    </script>
}
