@model dynamic
@{
    ViewBag.Title = "Registro de Empleado";
    var roles = ViewBag.Roles as List<syswb_Taller.Models.Roles> ?? new();
}

@section Header { }
@section Footer { }

@section Styles {
    <style>
        body {
            background: #f5f5f5;
            font-family: 'Segoe UI', sans-serif;
        }

        .register-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .register-card {
            background: white;
            padding: 2rem;
            border-radius: 1rem;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 500px;
        }

            .register-card h2 {
                text-align: center;
                margin-bottom: 1.5rem;
                color: #da8a3b;
                font-weight: 600;
            }

        .form-control:focus {
            border-color: #0097cc;
            box-shadow: 0 0 0 .2rem rgba(0,151,204,0.25);
        }

        .btn-register {
            background: #0097cc;
            border: none;
            width: 100%;
        }

            .btn-register:disabled {
                opacity: 0.6;
            }

        .form-text.invalid {
            color: #dc3545;
        }
    </style>
}

<div class="register-wrapper">
    <div class="register-card">
        <h2><i class="bi bi-person-plus-fill me-2"></i>Registrar Empleado</h2>
        <form asp-action="Registrar" method="post" novalidate id="formReg">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input name="pNombre" class="form-control" required />
                <div class="form-text invalid" data-valmsg-for="pNombre"></div>
            </div>
            <div class="mb-3">
                <label class="form-label">Apellido</label>
                <input name="pApellido" class="form-control" required />
                <div class="form-text invalid" data-valmsg-for="pApellido"></div>
            </div>
            <div class="mb-3">
                <label class="form-label">Teléfono</label>
                <input name="pTelefono" id="pTelefono" class="form-control" maxlength="9" placeholder="####-####" required />
                <div class="form-text invalid" data-valmsg-for="pTelefono"></div>
            </div>
            <div class="mb-3">
                <label class="form-label">Cédula</label>
                <input name="pCedula" id="pCedula" class="form-control" maxlength="13" placeholder="####-####-####" required />
                <div class="form-text invalid" data-valmsg-for="pCedula"></div>
            </div>
            <div class="mb-3">
                <label class="form-label">Usuario (login)</label>
                <input name="empUsuario" class="form-control" required />
                <div class="form-text invalid" data-valmsg-for="empUsuario"></div>
            </div>
            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input name="contrasena_texto" id="contrasena" type="password" class="form-control" required />
                <div class="form-text invalid" data-valmsg-for="contrasena_texto"></div>
            </div>
            <div class="mb-3">
                <label class="form-label">Confirmar Contraseña</label>
                <input id="confirm_pwd" type="password" class="form-control" required />
                <div class="form-text invalid" id="pwdMatchMsg"></div>
            </div>
            <div class="mb-3">
                <label class="form-label">Rol</label>
                <select name="idRol" class="form-select" required>
                    <option selected disabled>Seleccione rol</option>
                    @foreach (var r in roles)
                    {
                        <option value="@r.IdRol">@r.RTipo</option>
                    }
                </select>
                <div class="form-text invalid" data-valmsg-for="idRol"></div>
            </div>
            <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" id="termsChk" />
                <label class="form-check-label" for="termsChk">
                    Acepto los términos y condiciones
                </label>
            </div>
            <button type="submit" class="btn btn-register btn-lg text-white" id="btnSubmit" disabled>
                <i class="bi bi-check-circle-fill me-2"></i>Registrarme
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script>
        $(function () {
            // Mask teléfono ####-####
            $('#pTelefono').on('input', function () {
                let v = $(this).val().replace(/\D/g, '').slice(0, 8);
                if (v.length > 4) v = v.slice(0, 4) + '-' + v.slice(4);
                $(this).val(v);
            });

            // Mask cédula 001-221204-1029Q
            $('#pCedula').on('input', function () {
                let v = $(this).val().toUpperCase().replace(/[^A-Z0-9]/g, '');
                // Primera parte: 3 dígitos
                let part1 = v.slice(0, 3);
                // Segunda parte: 6 dígitos (fecha)
                let part2 = v.slice(3, 9);
                // Tercera parte: hasta 5 alfanuméricos
                let part3 = v.slice(9, 14);
                let result = part1;
                if (part2) result += '-' + part2;
                if (part3) result += '-' + part3;
                $(this).val(result);
            });
            // Contraseña match
            $('#contrasena, #confirm_pwd').on('input', function () {
                const pw = $('#contrasena').val(), cpw = $('#confirm_pwd').val();
                if (!cpw) $('#pwdMatchMsg').text('');
                else if (pw !== cpw) $('#pwdMatchMsg').text('No coinciden.').css('color', '#dc3545');
                else $('#pwdMatchMsg').text('¡Coincide!').css('color', '#198754');
                toggleSubmit();
            });
            // Términos checkbox
            $('#termsChk').on('change', toggleSubmit);
            // Validación vacíos
            $('#formReg').on('submit', function (e) {
                let valid = true;
                $(this).find('[required]').each(function () {
                    if (!$(this).val().trim()) {
                        valid = false;
                        $(`[data-valmsg-for="${this.name}"]`).text('Campo requerido');
                    } else {
                        $(`[data-valmsg-for="${this.name}"]`).text('');
                    }
                });
                if ($('#contrasena').val() !== $('#confirm_pwd').val()) {
                    valid = false;
                    $('#pwdMatchMsg').text('Las contraseñas deben coincidir').css('color', '#dc3545');
                }
                if (!valid) e.preventDefault();
            });
            function toggleSubmit() {
                const terms = $('#termsChk').is(':checked');
                const match = $('#contrasena').val() && $('#contrasena').val() === $('#confirm_pwd').val();
                $('#btnSubmit').prop('disabled', !(terms && match));
            }
        });
    </script>
}
