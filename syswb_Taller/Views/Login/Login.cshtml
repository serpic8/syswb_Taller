@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Taller+</title>

    <!-- Google Fonts: Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            min-height: 100%;
            margin: 0;
            font-family: 'Outfit', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: #1e293b;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem 1rem;
            /* Fondo elegante y profesional: Azul noche oscuro con brillo ambiental sutil */
            background: #0f172a;
            background-image: 
                radial-gradient(at 0% 0%, rgba(0, 151, 204, 0.22) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(241, 131, 22, 0.16) 0px, transparent 50%),
                radial-gradient(at 50% 50%, #0f172a 0%, #0a0f1d 100%);
            background-attachment: fixed;
        }

        .login-container {
            width: 100%;
            max-width: 440px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* Tarjeta de Login */
        .login-card {
            width: 100%;
            background: #ffffff;
            border-radius: 22px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.08);
            overflow: hidden;
            position: relative;
        }

        /* Franja superior con el gradiente de marca */
        .card-accent-bar {
            height: 5px;
            width: 100%;
            background: linear-gradient(90deg, #f18316 0%, #0097cc 100%);
        }

        .login-body {
            padding: 2.5rem 2.25rem 2rem;
        }

        /* Cabecera / Identidad */
        .brand-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .brand-icon-wrapper {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 62px;
            height: 62px;
            border-radius: 16px;
            background: linear-gradient(135deg, #f18316 0%, #0097cc 100%);
            color: #ffffff;
            font-size: 1.9rem;
            box-shadow: 0 10px 22px rgba(0, 151, 204, 0.3);
            margin-bottom: 1rem;
        }

        .brand-title {
            font-size: 2rem;
            font-weight: 800;
            color: #0f172a;
            letter-spacing: -0.5px;
            line-height: 1.1;
            margin-bottom: 0.35rem;
        }

        .brand-title span {
            color: #f18316;
        }

        .brand-subtitle {
            font-size: 0.92rem;
            color: #64748b;
            font-weight: 500;
            margin: 0;
        }

        /* Inputs Flotantes Estilizados */
        .form-floating {
            margin-bottom: 1.15rem;
            position: relative;
        }

        .form-floating > .form-control {
            border: 1.5px solid #e2e8f0;
            border-radius: 12px;
            background: #f8fafc;
            height: 56px;
            padding: 1rem 1rem 1rem 2.85rem;
            font-size: 0.98rem;
            color: #0f172a;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .form-floating > .form-control:focus {
            background: #ffffff;
            border-color: #0097cc;
            box-shadow: 0 0 0 4px rgba(0, 151, 204, 0.15);
            outline: none;
        }

        .form-floating > label {
            padding-left: 2.85rem;
            color: #64748b;
            font-weight: 500;
        }

        .form-floating > .input-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            font-size: 1.2rem;
            color: #94a3b8;
            pointer-events: none;
            z-index: 5;
            transition: color 0.2s ease;
        }

        .form-floating > .form-control:focus ~ .input-icon {
            color: #0097cc;
        }

        /* Toggle Mostrar/Ocultar Contraseña */
        .btn-toggle-password {
            position: absolute;
            right: 0.85rem;
            top: 50%;
            transform: translateY(-50%);
            background: transparent;
            border: none;
            color: #94a3b8;
            font-size: 1.2rem;
            padding: 0.35rem 0.5rem;
            cursor: pointer;
            z-index: 5;
            border-radius: 6px;
            transition: color 0.2s ease;
        }

        .btn-toggle-password:hover {
            color: #0097cc;
        }

        /* Botón de Ingreso Principal */
        .btn-submit {
            width: 100%;
            height: 50px;
            border: none;
            border-radius: 12px;
            background: linear-gradient(135deg, #0097cc 0%, #007bb3 100%);
            color: #ffffff;
            font-size: 1.05rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            box-shadow: 0 6px 18px rgba(0, 151, 204, 0.35);
            transition: all 0.25s ease;
            margin-top: 0.5rem;
            cursor: pointer;
        }

        .btn-submit:hover {
            background: linear-gradient(135deg, #0088b8 0%, #006b9c 100%);
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(0, 151, 204, 0.45);
            color: #ffffff;
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        /* Enlaces */
        .link-forgot {
            display: block;
            text-align: center;
            margin-top: 1.35rem;
            color: #0097cc;
            font-size: 0.92rem;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .link-forgot:hover {
            color: #007bb3;
            text-decoration: underline;
        }

        /* Mensajes de Alerta */
        .alert-custom {
            border-radius: 12px;
            padding: 0.9rem 1rem;
            margin-bottom: 1.25rem;
            font-size: 0.92rem;
            border: none;
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            background: #fef2f2;
            color: #b91c1c;
            border-left: 4px solid #ef4444;
            box-shadow: 0 2px 8px rgba(239, 68, 68, 0.08);
        }

        .alert-custom i {
            font-size: 1.15rem;
            margin-top: 1px;
            flex-shrink: 0;
        }

        /* Footer Inferior */
        .login-footer {
            margin-top: 1.75rem;
            text-align: center;
            font-size: 0.85rem;
            color: #94a3b8;
            font-weight: 500;
        }

        /* Móviles Pequeños */
        @@media (max-width: 480px) {
            body {
                padding: 1rem 0.75rem;
            }
            .login-body {
                padding: 2rem 1.35rem 1.5rem;
            }
            .brand-icon-wrapper {
                width: 52px;
                height: 52px;
                font-size: 1.6rem;
                border-radius: 14px;
            }
            .brand-title {
                font-size: 1.75rem;
            }
            .form-floating > .form-control {
                font-size: 16px; /* Evita zoom automático en Safari iOS */
            }
        }
    </style>
</head>
<body>

    <div class="login-container">
        <!-- Tarjeta de Login -->
        <div class="login-card">
            <div class="card-accent-bar"></div>

            <div class="login-body">
                <!-- Identidad Visual de Taller+ -->
                <div class="brand-header">
                    <div class="brand-icon-wrapper">
                        <i class="bi bi-wrench-adjustable-circle-fill"></i>
                    </div>
                    <h1 class="brand-title">Taller<span>+</span></h1>
                    <p class="brand-subtitle">Gestión Operativa de Taller Mecánico</p>
                </div>

                <!-- Formulario -->
                <form id="loginForm" asp-action="Login" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert-custom" role="alert">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <div>
                                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div>@err.ErrorMessage</div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Input Usuario -->
                    <div class="form-floating">
                        <i class="bi bi-person-fill input-icon"></i>
                        <input name="username" class="form-control" id="username" placeholder="Usuario" required autocomplete="username" />
                        <label for="username">Usuario</label>
                    </div>

                    <!-- Input Contraseña con Toggle para ver/ocultar -->
                    <div class="form-floating">
                        <i class="bi bi-lock-fill input-icon"></i>
                        <input name="password" type="password" class="form-control" id="password" placeholder="Contraseña" required autocomplete="current-password" />
                        <label for="password">Contraseña</label>
                        <button type="button" class="btn-toggle-password" id="togglePasswordBtn" title="Mostrar u ocultar contraseña">
                            <i class="bi bi-eye-slash" id="togglePasswordIcon"></i>
                        </button>
                    </div>

                    <!-- Botón Ingresar -->
                    <button id="submitBtn" type="submit" class="btn-submit">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Ingresar al Sistema</span>
                    </button>

                    <!-- Enlace Recuperar Contraseña -->
                    <a class="link-forgot" asp-controller="Login" asp-action="SolicitarRecuperacion">¿Olvidaste tu contraseña?</a>
                </form>
            </div>
        </div>

        <!-- Footer Copyright Limpio -->
        <div class="login-footer">
            &copy; @DateTime.Now.Year - syswb_Taller &bull; Todos los derechos reservados
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function(){
            // Limpiar bloqueos locales residuales para permitir acceso fluido
            localStorage.removeItem('loginLockUntil');
            localStorage.removeItem('loginAttempts');

            // Toggle para mostrar u ocultar contraseña
            $('#togglePasswordBtn').on('click', function(){
                var pwd = $('#password');
                var icon = $('#togglePasswordIcon');
                if (pwd.attr('type') === 'password') {
                    pwd.attr('type', 'text');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                } else {
                    pwd.attr('type', 'password');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                }
            });

            // Validación en cliente
            $('#loginForm').on('submit', function(e){
                var u = $('#username').val().trim();
                var p = $('#password').val().trim();
                if (!u || !p) {
                    alert("Por favor, ingresa tu usuario y contraseña.");
                    e.preventDefault();
                }
            });
        })();
    </script>
</body>
</html>
