@model syswb_Taller.Controllers.LoginController.RestablecerPasswordViewModel

@{
    ViewBag.Title = "Restablecer Contraseña";
}

@section Header { }
@section Footer { }

@section Styles {
    <style>
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #76d6ee 0%, #121bdf 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .recovery-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            background: white;
            padding: 3rem 2rem;
            border-radius: 1rem;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.2);
            width: 90vw;
            max-width: 420px;
            margin: auto;
            text-align: center;
        }

            .recovery-wrapper h3 {
                margin-bottom: 1.5rem;
                color: #da8a3b;
                font-weight: 600;
            }

        .form-control.is-invalid {
            border-color: #dc3545;
        }

        .text-danger {
            font-size: 0.875em;
        }

        .form-control {
            border-radius: .5rem;
            text-align: center; /* centra texto input */
        }

            .form-control:focus {
                border-color: #0097cc;
                box-shadow: 0 0 0 .2rem rgba(0,151,204,0.25);
            }

        .btn-send {
            background: #0097cc;
            border-radius: .5rem;
            padding: .75rem;
            font-size: 1.1rem;
            transition: background .3s;
            color: white;
            width: 100%;
            margin-top: 1rem;
        }

            .btn-send:hover {
                background: #007bb3;
                color: white;
            }

        .alert {
            width: 100%;
            text-align: center; /* centra texto mensajes */
        }
    </style>
}

<div class="recovery-wrapper">
    <h3><i class="bi bi-key-fill me-2"></i>Restablecer Contraseña</h3>

    <form asp-action="RestablecerPassword" method="post" novalidate id="resetForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Token" />

        <div class="mb-3">
            <label asp-for="NuevaContrasena" class="form-label fw-semibold"></label>
            <input asp-for="NuevaContrasena" type="password" class="form-control form-control-lg" placeholder="Nueva contraseña" required />
            <div class="invalid-feedback">
                La contraseña debe tener al menos 8 caracteres, 1 mayúscula y 1 punto ('.').
            </div>
            <span asp-validation-for="NuevaContrasena" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmarContrasena" class="form-label fw-semibold"></label>
            <input asp-for="ConfirmarContrasena" type="password" class="form-control form-control-lg" placeholder="Confirmar contraseña" required />
            <div class="invalid-feedback">
                Las contraseñas no coinciden.
            </div>
            <span asp-validation-for="ConfirmarContrasena" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-send" id="submitBtn" disabled>
            <i class="bi bi-check-circle me-2"></i>Cambiar Contraseña
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("resetForm");
            const nuevaPwd = form.querySelector("input[name='NuevaContrasena']");
            const confirmarPwd = form.querySelector("input[name='ConfirmarContrasena']");
            const submitBtn = document.getElementById("submitBtn");

            // RegEx: mínimo 8 caracteres, al menos 1 mayúscula, al menos 1 punto '.'
            const pwdRegex = /^(?=.*[A-Z])(?=.*[.]).{8,}$/;

            function validatePassword() {
                const val = nuevaPwd.value;
                if (pwdRegex.test(val)) {
                    nuevaPwd.classList.remove("is-invalid");
                    return true;
                } else {
                    nuevaPwd.classList.add("is-invalid");
                    return false;
                }
            }

            function validateConfirmPassword() {
                if (confirmarPwd.value === nuevaPwd.value && confirmarPwd.value.length > 0) {
                    confirmarPwd.classList.remove("is-invalid");
                    return true;
                } else {
                    confirmarPwd.classList.add("is-invalid");
                    return false;
                }
            }

            function toggleSubmit() {
                submitBtn.disabled = !(validatePassword() && validateConfirmPassword());
            }

            nuevaPwd.addEventListener("input", () => {
                validatePassword();
                validateConfirmPassword();
                toggleSubmit();
            });

            confirmarPwd.addEventListener("input", () => {
                validateConfirmPassword();
                toggleSubmit();
            });

            form.addEventListener("submit", function (e) {
                if (!validatePassword() || !validateConfirmPassword()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                form.classList.add("was-validated");
            });

            toggleSubmit();
        });
    </script>
}
