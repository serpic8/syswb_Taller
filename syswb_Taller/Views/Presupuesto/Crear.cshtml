@model dynamic
@using System.Globalization

@{
    int idPresupuesto = Model?.IdPresupuesto ?? 0;
    bool esCreacion = idPresupuesto == 0;
    ViewBag.Title = esCreacion ? "Nuevo Presupuesto" : "Editar Presupuesto";
    DateTime fecha = esCreacion ? DateTime.Now : Model.Fecha;
    double costoTotal = esCreacion ? 0.0 : Model.CostoTotal;
    var niCulture = new CultureInfo("es-NI");

    // — CORRECCIÓN: casteamos a los tipos reales para que no queden vacíos —
    var packs = ViewBag.Packs as List<syswb_Taller.Models.PackReparacion> ?? new();
    var productos = ViewBag.Productos as List<syswb_Taller.Models.ProductoRepuesto> ?? new();
    var servicios = ViewBag.Servicios as List<syswb_Taller.Models.Servicio> ?? new();
    var detalles = Model?.Detalles as List<dynamic> ?? new List<dynamic>();
}

<h2>@ViewBag.Title</h2>

<form asp-action="@(esCreacion ? "CrearPresupuesto" : "ActualizarPresupuesto")" method="post" class="mb-4">
    @Html.AntiForgeryToken()
    @if (esCreacion)
    {
        <input type="hidden" name="clienteID" value="@ViewBag.ClienteID" />
        <input type="hidden" name="idVehiculo" value="@ViewBag.IdVehiculo" />
    }
    else
    {
        <input type="hidden" name="idPresupuesto" value="@idPresupuesto" />
    }

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <label class="form-label">Número de Presupuesto</label>
            <input class="form-control"
                   value="@(esCreacion ? "(se genera al guardar)" : idPresupuesto.ToString())"
                   readonly />
        </div>
        <div class="col-md-4">
            <label class="form-label">Fecha</label>
            <input class="form-control"
                   value="@fecha.ToString("dd/MM/yyyy")"
                   readonly />
        </div>
        <div class="col-md-4">
            <label class="form-label">Costo Total</label>
            <input class="form-control"
                   value="@costoTotal.ToString("C", niCulture)"
                   readonly />
        </div>

        <div class="col-md-6">
            <label class="form-label">Cliente</label>
            <input class="form-control" value="@ViewBag.ClienteNombre" readonly />
        </div>
        <div class="col-md-6">
            <label class="form-label">Matrícula del Vehículo</label>
            <input class="form-control" value="@ViewBag.Matricula" readonly />
        </div>

        <div class="col-12">
            <label class="form-label">Descripción de la falla</label>
            <textarea name="preFalla"
                      class="form-control"
                      rows="3"
                      required>@(esCreacion ? "" : Model.PreFalla)</textarea>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-@(esCreacion ? "success" : "primary")">
                @(esCreacion ? "Crear Presupuesto" : "Guardar Cambios")
            </button>
            <a asp-action="Lista" class="btn btn-secondary ms-2">Cancelar</a>
        </div>
    </div>
</form>

@if (!esCreacion)
{
    <hr />
    <div class="row mb-4">
        <div class="col-md-4">
            <h5>Agregar Pack</h5>
            <form asp-action="AgregarPack" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idPresupuesto" value="@idPresupuesto" />
                <div class="col-8">
                    <select name="idPack" class="form-select" required>
                        <option selected disabled>Seleccione pack</option>
                        @foreach (var p in packs)
                        {
                            <option value="@p.IdPack">@p.PckNombre</option>
                        }
                    </select>
                </div>
                <div class="col-2">
                    <input name="ppCantidad" type="number" value="1" min="1" class="form-control" />
                </div>
                <div class="col-2">
                    <button class="btn btn-outline-primary">+</button>
                </div>
            </form>
        </div>

        <div class="col-md-4">
            <h5>Agregar Producto</h5>
            <form asp-action="AgregarProducto" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idPresupuesto" value="@idPresupuesto" />
                <div class="col-8">
                    <select name="idProducto" class="form-select" required>
                        <option selected disabled>Seleccione producto</option>
                        @foreach (var pr in productos)
                        {
                            <option value="@pr.IdProducto">@pr.PrNombre</option>
                        }
                    </select>
                </div>
                <div class="col-2">
                    <input name="ppCantidad" type="number" value="1" min="1" class="form-control" />
                </div>
                <div class="col-2">
                    <button class="btn btn-outline-primary">+</button>
                </div>
            </form>
        </div>

        <div class="col-md-4">
            <h5>Agregar Servicio</h5>
            <form asp-action="AgregarServicio" method="post" class="row g-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idPresupuesto" value="@idPresupuesto" />
                <div class="col-8">
                    <select name="idServicio" class="form-select" required>
                        <option selected disabled>Seleccione servicio</option>
                        @foreach (var s in servicios)
                        {
                            <option value="@s.IdServicio">@s.SerNombre</option>
                        }
                    </select>
                </div>
                <div class="col-2">
                    <input name="psCantidad" type="number" value="1" min="1" class="form-control" />
                </div>
                <div class="col-2">
                    <button class="btn btn-outline-primary">+</button>
                </div>
            </form>
        </div>
    </div>

    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr>
                <th>Tipo</th>
                <th>Nombre</th>
                <th class="text-end">Cantidad</th>
                <th class="text-end">Precio Unit.</th>
                <th class="text-end">Subtotal</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in detalles)
            {
                <tr>
                    <td>@d.Tipo</td>
                    <td>@d.Nombre</td>
                    <td class="text-end">
                        <form asp-action="@(d.Tipo == "Pack" ? "ActualizarPack"
                                        : d.Tipo == "Producto" ? "ActualizarProducto"
                                        : "ActualizarServicio")"
                              method="post" class="d-inline-flex">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idDetalle" value="@d.IdDetalle" />
                            <input name="@(d.Tipo == "Pack" ? "ppCantidad"
                                       : d.Tipo == "Producto" ? "ppCantidad"
                                       : "psCantidad")"
                                   type="number" value="@d.Cantidad" min="1"
                                   class="form-control form-control-sm me-2 text-end"
                                   style="width:4rem;" />
                            <button class="btn btn-sm btn-outline-primary">✎</button>
                        </form>
                    </td>
                    <td class="text-end">
                        @((d.Tipo == "Pack" ? d.PrecioPack : d.PrecioUnit).ToString("C", niCulture))
                    </td>
                    <td class="text-end">
                        @((d.Cantidad * (d.Tipo == "Pack" ? d.PrecioPack : d.PrecioUnit))
                            .ToString("C", niCulture))
                    </td>
                    <td class="text-center">
                        <form asp-action="@(d.Tipo == "Pack" ? "EliminarPack"
                                        : d.Tipo == "Producto" ? "EliminarProducto"
                                        : "EliminarServicio")"
                              method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="idDetalle" value="@d.IdDetalle" />
                            <button class="btn btn-sm btn-danger">✖</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
