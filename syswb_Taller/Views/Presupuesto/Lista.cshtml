@model List<dynamic>

@{
    ViewBag.Title = "Listado de Presupuestos";
    var list = Model;
    string filtroCliente = ViewBag.FiltroCliente as string ?? "";
    bool? filtroActivo = ViewBag.FiltroActivo as bool?;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

@section Header { }
@section Footer { }

@section Styles {
    <style>
        .header-filter {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }
        .filter-form {
            display: flex;
            gap: 1rem;
        }
        .filter-form .form-label {
            margin-bottom: .25rem;
        }
        .table-card {
            border-radius: .5rem;
            overflow: hidden;
            box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        }
        .table-card .card-header {
            background: #0097cc;
            color: #fff;
            font-weight: 600;
            padding: .75rem 1.25rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .table-card table tr:hover {
            background-color: rgba(0,151,204,0.05);
            cursor: pointer;
        }
        .table th, .table td {
            vertical-align: middle;
        }
    </style>
}

<div class="d-flex justify-content-end mb-3">
    <a asp-controller="Menu" asp-action="Menu"
       class="btn btn-outline-primary btn-lg shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-house-door-fill fs-5"></i>
        <span>Menú Principal</span>
    </a>
</div>

<div class="container mt-4">

    <div class="header-filter">
        <div class="d-flex align-items-center">
            <i class="bi bi-file-earmark-text fs-3 text-primary me-2"></i>
            <h1 class="h4 fw-bold mb-0">Presupuestos</h1>
        </div>

        <form method="get" asp-action="Lista" class="filter-form">
            <div>
                <label class="form-label d-block"><i class="bi bi-person me-1"></i>Cliente</label>
                <input name="cliente" class="form-control form-control-sm" value="@filtroCliente" placeholder="Buscar cliente..." />
            </div>
            <div>
                <label class="form-label d-block"><i class="bi bi-toggle2-on me-1"></i>Activo</label>
                <select name="activo" class="form-select form-select-sm">
                    <option value="">-- Todos --</option>
                    <!option value="true" @(filtroActivo == true ? "selected" : "")>Sí</!option>
                    <!option value="false" @(filtroActivo == false ? "selected" : "")>No</!option>
                </select>
            </div>
            <div class="d-flex align-items-end">
                <button class="btn btn-primary btn-sm">
                    <i class="bi bi-funnel-fill me-1"></i>Filtrar
                </button>
            </div>
        </form>
    </div>

    <div class="table-card">
        <div class="card-header">
            <span><i class="bi bi-list-columns-reverse me-2"></i>Listado de Presupuestos</span>
            <a asp-controller="Cliente" asp-action="Crear" asp-route-redirigirA="Presupuesto" class="btn btn-primary">
                <i class="bi bi-person-plus me-1"></i> Crear presupuesto
            </a>


        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th><i class="bi bi-hash me-1"></i>ID</th>
                        <th><i class="bi bi-calendar me-1"></i>Fecha</th>
                        <th><i class="bi bi-person me-1"></i>Cliente</th>
                        <th><i class="bi bi-info-circle me-1"></i>Estado</th>
                        <th class="text-end"><i class="bi bi-currency-dollar me-1"></i>Costo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (list.Any())
                    {
                        foreach (var p in list)
                        {
                            <tr ondblclick="window.location='@Url.Action("EditarPresupuesto","Presupuesto", new { id = p.Id })'">
                                <td>@p.Id</td>
                                <td>@p.Fecha.ToString("g")</td>
                                <td>@p.Cliente</td>
                                <td>
                                    @if (p.Estado)
                                    {
                                        <span class="text-success">Aprobado</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning">Pendiente</span>
                                    }
                                </td>
                                <td class="text-end">@p.Costo.ToString("C")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4">
                                <i class="bi bi-exclamation-circle me-2"></i>No se encontraron presupuestos.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
