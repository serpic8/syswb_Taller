@using System.Globalization
@{
    ViewBag.Title = "Resumen de Caja Diaria";
    var resumen      = ViewBag.Resumen      as List<dynamic> ?? new List<dynamic>();
    int anio         = ViewBag.SelectedYear  ?? DateTime.Today.Year;
    int mes          = ViewBag.SelectedMonth ?? DateTime.Today.Month;
    bool cajaAbierta = ViewBag.CajaAbierta   ?? false;

}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

@section Header { }
@section Footer { }

<style>
    .filter-bar {
        background: #fff;
        padding: 1rem;
        border-radius: .5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        margin-bottom: 2rem;
    }
    .filter-bar .btn-group a.active,
    .filter-bar .btn-group a.btn-primary {
        background-color: #0097cc;
        color: #fff;
        border-color: #0097cc;
    }
    .table-card {
        border-radius: .5rem;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    }
    .table-card .card-header {
        background: #0097cc;
        color: #fff;
        font-weight: 600;
    }
    .table-card tbody tr:hover {
        background: rgba(0,151,204,0.1);
        cursor: pointer;
    }
    .btn-caja {
        padding: .5rem 1.5rem;
        font-weight: 500;
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <script>alert("@TempData["SuccessMessage"]");</script>
}

<div class="d-flex justify-content-end mb-3">
    <a asp-controller="Menu" asp-action="Menu"
       class="btn btn-outline-primary btn-lg shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-house-door-fill fs-5"></i>
        <span>Menú Principal</span>
    </a>
</div>

<div class="container mt-4">
    <h2 class="mb-4"><i class="bi bi-box-seam me-2"></i>Resumen de Caja Diaria</h2>

    <div class="filter-bar row align-items-center">
        <div class="col-md-6">
            <div class="btn-group" role="group">
                <a href="@Url.Action("Resumen","MovimientoFinanciero")" class="btn btn-outline-secondary">
                    <i class="bi bi-speedometer2 me-1"></i> Resumen
                </a>
                <a href="@Url.Action("Index","Trabajadores")" class="btn btn-outline-secondary">
                    <i class="bi bi-people-fill me-1"></i> Trabajadores
                </a>
                <a href="@Url.Action("Lista","Proveedor")" class="btn btn-outline-secondary">
                    <i class="bi bi-truck-flatbed me-1"></i> Proveedores
                </a>
                <a href="@Url.Action("ListaMovimientos","MovimientoFinanciero")" class="btn btn-outline-secondary">
                    <i class="bi bi-cash-stack me-1"></i> Finanzas
                </a>
                <a href="@Url.Action("Lista","CajaDiaria")" class="btn btn-primary">
                    <i class="bi bi-box-seam me-1"></i> Caja Diaria
                </a>
            </div>
        </div>

        <div class="col-md-6 d-flex justify-content-end align-items-center">
            @if (!cajaAbierta)
            {
                <form asp-action="AbrirCaja" asp-controller="CajaDiaria" method="post" class="d-inline me-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="anio" value="@anio" />
                    <input type="hidden" name="mes" value="@mes" />
                    <button type="submit" class="btn btn-success btn-caja">
                        <i class="bi bi-box-arrow-in-down me-1"></i>Abrir Caja
                    </button>
                </form>
            }
            else
            {
                <form asp-action="CerrarCaja" asp-controller="CajaDiaria" method="post" class="d-inline me-3"
                      onsubmit="return confirm('¿Seguro que deseas cerrar la caja?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="anio" value="@anio" />
                    <input type="hidden" name="mes" value="@mes" />
                    <button type="submit" class="btn btn-danger btn-caja">
                        <i class="bi bi-box-arrow-up me-1"></i>Cerrar Caja
                    </button>
                </form>
            }

            <form method="get" class="d-flex align-items-end" id="filtroForm">
                <div class="me-3">
                    <label for="anio" class="form-label mb-1">
                        <i class="bi bi-calendar3 me-1"></i>Año
                    </label>
                    <input type="number" class="form-control form-control-sm"
                           name="anio" id="anio" value="@anio"
                           min="2000" max="@DateTime.Now.Year" />
                </div>
                <div class="me-3">
                    <label for="mes" class="form-label mb-1">
                        <i class="bi bi-calendar2-month me-1"></i>Mes
                    </label>
                    <select class="form-select form-select-sm" name="mes" id="mes">
                        <option value="">-- Todos --</option>
                        @for (int i = 1; i <= 12; i++)
                        {
                            var nombre = CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i);
                            <!option value="@i" @(mes == i ? "selected" : "")>@nombre</!option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-sm btn-primary align-self-end">
                    <i class="bi bi-search me-1"></i>Filtrar
                </button>
            </form>
        </div>
    </div>

    <div class="table-card">
        <div class="card-header">
            <i class="bi bi-calendar2-week me-2"></i>Detalle de Caja por Día
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th class="text-end">Ingreso</th>
                        <th class="text-end">Egreso</th>
                        <th class="text-end">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @if (resumen.Any())
                    {
                        @foreach (var r in resumen)
                        {
                            var fechaFormateada = ((DateTime)r.Fecha).ToString("yyyy-MM-dd");
                            var ingreso = ((double)r.Ingreso).ToString("C", new CultureInfo("es-NI"));
                            var egreso = ((double)r.Egreso).ToString("C", new CultureInfo("es-NI"));
                            var balance = ((double)r.Balance).ToString("C", new CultureInfo("es-NI"));

                            <tr style="cursor:pointer"
                                onclick="location.href='@Url.Action("Detalle","CajaDiaria", new { idCaja = r.IdCaja, fecha = ((DateTime)r.Fecha).ToString("yyyy-MM-dd") })'">
                                <td>@fechaFormateada</td>
                                <td class="text-end">@ingreso</td>
                                <td class="text-end">@egreso</td>
                                <td class="text-end">@balance</td>
                            </tr>
                        }

                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4">
                                <i class="bi bi-exclamation-circle me-2"></i>No hay registros para este mes.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
