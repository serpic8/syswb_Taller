@{
    ViewBag.Title = "Listado de Packs";
    var packs = ViewBag.Packs as List<dynamic> ?? new List<dynamic>();
    string filtroNombre = ViewBag.FiltroNombre as string ?? "";
    bool? filtroActivo = ViewBag.FiltroActivo as bool?;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

@section Header { }
@section Footer { }

@section Styles {
    <style>
        .header-filter {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }
        .filter-form {
            display: flex;
            gap: 1rem;
        }
        .filter-form .form-label {
            margin-bottom: .25rem;
        }
        .table-card {
            border-radius: .5rem;
            overflow: hidden;
            box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        }
        .table-card .card-header {
            background: #0097cc;
            color: #fff;
            font-weight: 600;
            padding: .75rem 1.25rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .table-card table tr:hover {
            background-color: rgba(0,151,204,0.05);
            cursor: pointer;
        }
        .table th, .table td {
            vertical-align: middle;
        }
    </style>
}

<div class="d-flex justify-content-end mb-3">
    <a asp-controller="Menu" asp-action="Menu"
       class="btn btn-outline-primary btn-lg shadow-sm d-flex align-items-center gap-2">
        <i class="bi bi-house-door-fill fs-5"></i>
        <span>Menú Principal</span>
    </a>
</div>

<div class="container mt-4">

    <div class="header-filter">
        <div class="d-flex align-items-center">
            <i class="bi bi-box-seam fs-3 text-primary me-2"></i>
            <h1 class="h4 fw-bold mb-0">Packs</h1>
        </div>

        <form method="get" asp-action="Lista" class="filter-form">
            <div>
                <label class="form-label d-block"><i class="bi bi-card-text me-1"></i>Nombre</label>
                <input name="nombre" class="form-control form-control-sm" value="@filtroNombre" placeholder="Buscar..." />
            </div>
            <div>
                <label class="form-label d-block"><i class="bi bi-toggle2-on me-1"></i>Activo</label>
                <select name="activo" class="form-select form-select-sm">
                    <option value="">-- Todos --</option>
                    <!option value="true" @(filtroActivo == true ? "selected" : "")>Sí</!option>
                    <!option value="false" @(filtroActivo == false ? "selected" : "")>No</!option>
                </select>
            </div>
            <div class="d-flex align-items-end">
                <button class="btn btn-primary btn-sm">
                    <i class="bi bi-funnel-fill me-1"></i>Filtrar
                </button>
            </div>
        </form>
    </div>

    <div class="table-card">
        <div class="card-header">
            <span><i class="bi bi-list-columns-reverse me-2"></i>Listado de Packs</span>
            <a asp-action="Crear" class="btn btn-sm btn-success">
                <i class="bi bi-plus-circle-fill me-1"></i>Nuevo Pack
            </a>
        </div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th><i class="bi bi-hash me-1"></i>ID</th>
                        <th><i class="bi bi-card-text me-1"></i>Nombre</th>
                        <th class="text-end"><i class="bi bi-currency-dollar me-1"></i>Precio</th>
                        <th class="text-center"><i class="bi bi-check-circle me-1"></i>Activo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (packs.Any())
                    {
                        foreach (var p in packs)
                        {
                            <tr ondblclick="window.location='@Url.Action("Editar","Pack",new { id = p.IdPack })'">
                                <td>@p.IdPack</td>
                                <td>@p.Nombre</td>
                                <td class="text-end">@p.Precio.ToString("C")</td>
                                <td class="text-center" onclick="event.stopPropagation();">
                                    <form asp-action="CambiarEstado" method="post" class="d-inline" onsubmit="event.stopPropagation();">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="idPack" value="@p.IdPack" />
                                        <button type="submit" class="btn btn-sm p-0 text-center" title="Alternar estado">
                                            @if (p.Activo)
                                            {
                                                <i class="bi bi-check-lg text-success"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-x-lg text-danger"></i>
                                            }
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4">
                                <i class="bi bi-exclamation-circle me-2"></i>No se encontraron packs.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
