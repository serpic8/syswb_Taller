@{
    ViewData["Title"] = "Panel de trabajo";
    var usuario = User.Identity?.Name ?? "Usuario";
    var cajaAbierta = ViewBag.CajaAbierta as bool? ?? false;
}

@section Header { }
@section Footer { }

<div class="workshop-dashboard">
    <header class="dashboard-header">
        <a class="dashboard-brand" asp-controller="Menu" asp-action="Menu" aria-label="Taller Plus, inicio">
            <span class="brand-mark"><i class="bi bi-wrench-adjustable-circle-fill" aria-hidden="true"></i></span>
            <span>Taller<span class="brand-accent">+</span><small>Gestión operativa</small></span>
        </a>
        <div class="dashboard-account">
            <span class="cash-status @(cajaAbierta ? "is-open" : "is-closed")">
                <span class="status-dot" aria-hidden="true"></span>
                Caja @(cajaAbierta ? "abierta" : "cerrada")
            </span>
            <span class="dashboard-clock"><i class="bi bi-clock" aria-hidden="true"></i><span id="liveClock"></span></span>
            <span class="dashboard-user"><i class="bi bi-person-circle" aria-hidden="true"></i>@usuario</span>
            <form asp-controller="Menu" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-box-arrow-right me-1" aria-hidden="true"></i>Salir
                </button>
            </form>
        </div>
    </header>

    <div class="dashboard-content">
        <section class="dashboard-welcome" aria-labelledby="dashboardTitle">
            <div>
                <p class="dashboard-eyebrow">PANEL DE TRABAJO</p>
                <h1 id="dashboardTitle">Hola, @usuario</h1>
                <p>Accede a las tareas y registros de tu taller.</p>
            </div>
            <div class="dashboard-actions">
                <form asp-controller="CajaDiaria" asp-action="@(cajaAbierta ? "CerrarCaja" : "AbrirCaja")" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn @(cajaAbierta ? "btn-outline-danger" : "btn-warning")">
                        <i class="bi @(cajaAbierta ? "bi-lock" : "bi-unlock") me-1" aria-hidden="true"></i>
                        @(cajaAbierta ? "Cerrar caja" : "Abrir caja")
                    </button>
                </form>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#chooseTypeModal">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Crear
                </button>
            </div>
        </section>

        @if (TempData["SuccessMessage"] is string mensaje)
        {
            <div class="alert alert-info" role="status">@mensaje</div>
        }

        <section class="dashboard-section" aria-labelledby="operationsTitle">
            <div class="dashboard-section-heading">
                <div>
                    <h2 id="operationsTitle">Operación del taller</h2>
                    <p>Gestiona el trabajo diario y el seguimiento de cada vehículo.</p>
                </div>
            </div>
            <div class="module-grid">
                <a class="module-card module-card-featured" asp-controller="Menu" asp-action="Orden">
                    <span class="module-icon"><i class="bi bi-clipboard2-check" aria-hidden="true"></i></span>
                    <span class="module-copy"><strong>Órdenes de trabajo</strong><small>Consulta el avance y las entregas del taller.</small></span>
                    <i class="bi bi-arrow-up-right module-arrow" aria-hidden="true"></i>
                </a>
                <a class="module-card" asp-controller="Menu" asp-action="Presupuesto">
                    <span class="module-icon"><i class="bi bi-receipt" aria-hidden="true"></i></span>
                    <span class="module-copy"><strong>Presupuestos</strong><small>Prepara y consulta cotizaciones.</small></span>
                    <i class="bi bi-arrow-up-right module-arrow" aria-hidden="true"></i>
                </a>
                <a class="module-card" asp-controller="Menu" asp-action="Clientes">
                    <span class="module-icon"><i class="bi bi-people" aria-hidden="true"></i></span>
                    <span class="module-copy"><strong>Clientes</strong><small>Consulta y actualiza sus datos.</small></span>
                    <i class="bi bi-arrow-up-right module-arrow" aria-hidden="true"></i>
                </a>
                <a class="module-card" asp-controller="Menu" asp-action="Vehiculos">
                    <span class="module-icon"><i class="bi bi-car-front" aria-hidden="true"></i></span>
                    <span class="module-copy"><strong>Vehículos</strong><small>Revisa los vehículos registrados.</small></span>
                    <i class="bi bi-arrow-up-right module-arrow" aria-hidden="true"></i>
                </a>
            </div>
        </section>

        <section class="dashboard-section" aria-labelledby="catalogTitle">
            <div class="dashboard-section-heading">
                <div>
                    <h2 id="catalogTitle">Catálogos y recursos</h2>
                    <p>Administra los productos y servicios disponibles.</p>
                </div>
            </div>
            <div class="module-grid module-grid-compact">
                <a class="module-card" asp-controller="Menu" asp-action="Productos">
                    <span class="module-icon"><i class="bi bi-box-seam" aria-hidden="true"></i></span>
                    <span class="module-copy"><strong>Inventario</strong><small>Productos y repuestos.</small></span>
                    <i class="bi bi-arrow-up-right module-arrow" aria-hidden="true"></i>
                </a>
                <a class="module-card" asp-controller="Menu" asp-action="Servicios">
                    <span class="module-icon"><i class="bi bi-tools" aria-hidden="true"></i></span>
                    <span class="module-copy"><strong>Servicios</strong><small>Trabajos y tarifas.</small></span>
                    <i class="bi bi-arrow-up-right module-arrow" aria-hidden="true"></i>
                </a>
                <a class="module-card" asp-controller="Menu" asp-action="Packs">
                    <span class="module-icon"><i class="bi bi-boxes" aria-hidden="true"></i></span>
                    <span class="module-copy"><strong>Packs</strong><small>Combina servicios y productos.</small></span>
                    <i class="bi bi-arrow-up-right module-arrow" aria-hidden="true"></i>
                </a>
                @if (User.IsInRole("Administrador") || User.IsInRole("Supervisor"))
                {
                    <a class="module-card" asp-controller="Menu" asp-action="Administracion">
                        <span class="module-icon"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i></span>
                        <span class="module-copy"><strong>Finanzas</strong><small>Consulta los movimientos del negocio.</small></span>
                        <i class="bi bi-arrow-up-right module-arrow" aria-hidden="true"></i>
                    </a>
                }
                @if (User.IsInRole("Cajero"))
                {
                    <a class="module-card" asp-controller="Menu" asp-action="CajaDiaria">
                        <span class="module-icon"><i class="bi bi-cash-stack" aria-hidden="true"></i></span>
                        <span class="module-copy"><strong>Caja diaria</strong><small>Consulta cierres y movimientos.</small></span>
                        <i class="bi bi-arrow-up-right module-arrow" aria-hidden="true"></i>
                    </a>
                }
            </div>
        </section>
        <footer class="dashboard-footer">Taller+ <span aria-hidden="true">·</span> Gestión operativa</footer>
    </div>
</div>

<div class="modal fade" id="chooseTypeModal" tabindex="-1" aria-labelledby="chooseTypeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="chooseTypeModalLabel">¿Qué deseas crear?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Elige el tipo de registro para continuar.</p>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-primary" id="btnCreateOrder"><i class="bi bi-clipboard2-check me-2" aria-hidden="true"></i>Orden de trabajo</button>
                    <button type="button" class="btn btn-outline-primary" id="btnCreatePresupuesto"><i class="bi bi-receipt me-2" aria-hidden="true"></i>Presupuesto</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="chooseClientOrderModal" tabindex="-1" aria-labelledby="chooseClientOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="chooseClientOrderModalLabel">Nueva orden</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Primero, indica a quién pertenece el vehículo.</p>
                <div class="d-grid gap-2">
                    <a asp-controller="Cliente" asp-action="Crear" asp-route-redirigirA="Orden" class="btn btn-primary"><i class="bi bi-person-plus me-2" aria-hidden="true"></i>Registrar cliente</a>
                    <a asp-controller="Orden" asp-action="SeleccionarClienteOrden" class="btn btn-outline-secondary"><i class="bi bi-person-check me-2" aria-hidden="true"></i>Elegir cliente existente</a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="chooseClientPresModal" tabindex="-1" aria-labelledby="chooseClientPresModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="chooseClientPresModalLabel">Nuevo presupuesto</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Primero, indica a quién pertenece el vehículo.</p>
                <div class="d-grid gap-2">
                    <a asp-controller="Cliente" asp-action="Crear" asp-route-redirigirA="Presupuesto" class="btn btn-primary"><i class="bi bi-person-plus me-2" aria-hidden="true"></i>Registrar cliente</a>
                    <a asp-controller="Presupuesto" asp-action="SeleccionarClientePresupuesto" class="btn btn-outline-secondary"><i class="bi bi-person-check me-2" aria-hidden="true"></i>Elegir cliente existente</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateClock() {
            const now = new Date();
            const options = { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' };
            document.getElementById('liveClock').textContent = now.toLocaleString('es-NI', options);
        }
        setInterval(updateClock, 1000);
        updateClock();

        const chooseTypeModal = new bootstrap.Modal(document.getElementById('chooseTypeModal'));
        const orderModal = new bootstrap.Modal(document.getElementById('chooseClientOrderModal'));
        const presupuestoModal = new bootstrap.Modal(document.getElementById('chooseClientPresModal'));
        document.getElementById('btnCreateOrder').addEventListener('click', () => {
            chooseTypeModal.hide();
            orderModal.show();
        });
        document.getElementById('btnCreatePresupuesto').addEventListener('click', () => {
            chooseTypeModal.hide();
            presupuestoModal.show();
        });
    </script>
}
