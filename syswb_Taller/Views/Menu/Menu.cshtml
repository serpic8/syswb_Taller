@using System.Security.Claims
@{
    ViewData["Title"] = "Menú Principal";
    var usuario = User.Identity?.Name ?? "Usuario";
    var rol = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "Personal";
    var cajaAbierta = ViewBag.CajaAbierta as bool? ?? false;
}

@section Header { }
@section Footer { }

<!-- Fuentes: Outfit (Misma del Login) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

@section Styles {
    <style>
        :root {
            --color-blue: #0097cc;
            --color-blue-dark: #007bb3;
            --color-orange: #f18316;
            --color-orange-dark: #d9700e;
            --color-green: #10b981;
            --color-navy: #151b26;
            --color-navy-dark: #0f141d;
            --bg-page: #f4f6f9;
            --card-border: #e4e8ef;
            --text-dark: #151b26;
        }

        html, body {
            height: 100%;
            margin: 0;
            background-color: var(--bg-page) !important;
            font-family: 'Outfit', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
            color: var(--text-dark);
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            padding-bottom: 58px; /* Espacio para barra inferior */
        }

        /* ---- TOP BAR (Estilo Original Limpio) ---- */
        .top-bar {
            position: sticky;
            top: 0;
            background: var(--color-navy);
            color: #ffffff;
            padding: 0.85rem clamp(1rem, 4vw, 3.5rem);
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 1000;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);
            flex-wrap: wrap;
            gap: 1rem;
        }

        .brand-link {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            color: #ffffff !important;
            text-decoration: none;
        }

        .brand-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--color-orange) 0%, var(--color-blue) 100%);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 1.3rem;
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.25);
        }

        .brand-title {
            font-size: 1.4rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            line-height: 1;
        }

        .brand-title span {
            color: var(--color-orange);
        }

        .top-right {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            flex-wrap: wrap;
        }

        .status-caja-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.35rem 0.85rem;
            border-radius: 50rem;
            font-size: 0.84rem;
            font-weight: 600;
            border: 1px solid rgba(255, 255, 255, 0.12);
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
        }

        .status-caja-pill.abierta {
            background: rgba(16, 185, 129, 0.15);
            border-color: rgba(16, 185, 129, 0.4);
            color: #34d399;
        }

        .status-caja-pill.cerrada {
            background: rgba(241, 131, 22, 0.15);
            border-color: rgba(241, 131, 22, 0.4);
            color: #fb923c;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: currentColor;
            display: inline-block;
        }

        .user-dropdown-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 0.38rem 0.95rem;
            border-radius: 50rem;
            color: #ffffff !important;
            font-size: 0.88rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: none;
        }

        .user-dropdown-btn:hover,
        .user-dropdown-btn[aria-expanded="true"] {
            background: rgba(255, 255, 255, 0.16);
            border-color: rgba(255, 255, 255, 0.3);
            color: #ffffff !important;
        }

        .user-dropdown-btn::after {
            display: inline-block;
            margin-left: 0.35rem;
            vertical-align: 0.15em;
            content: "";
            border-top: 0.35em solid;
            border-right: 0.3em solid transparent;
            border-bottom: 0;
            border-left: 0.3em solid transparent;
            color: #cbd5e1;
            transition: transform 0.2s ease;
        }

        .user-dropdown-btn[aria-expanded="true"]::after {
            transform: rotate(180deg);
        }

        .user-role-tag {
            font-size: 0.68rem;
            font-weight: 800;
            padding: 0.15rem 0.5rem;
            border-radius: 50rem;
            background: var(--color-blue);
            color: #ffffff;
            text-transform: uppercase;
        }

        /* Menú Desplegable de Usuario */
        .user-dropdown-menu {
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            box-shadow: 0 12px 32px rgba(15, 23, 42, 0.16);
            padding: 0.6rem;
            min-width: 220px;
            margin-top: 0.65rem !important;
            background: #ffffff;
            z-index: 1050;
        }

        .user-dropdown-header {
            padding: 0.5rem 0.75rem 0.6rem;
            border-bottom: 1px solid #f1f5f9;
            margin-bottom: 0.4rem;
        }

        .user-header-name {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-dark);
            line-height: 1.2;
        }

        .user-header-role {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--color-blue);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .user-dropdown-menu .dropdown-item {
            border-radius: 10px;
            padding: 0.6rem 0.85rem;
            font-weight: 600;
            font-size: 0.92rem;
            color: #334155;
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            border: none;
            background: transparent;
            width: 100%;
            cursor: pointer;
        }

        .user-dropdown-menu .dropdown-item:hover {
            background: #f8fafc;
            color: #0f172a;
        }

        .user-dropdown-menu .dropdown-item.caja-close-item:hover,
        .user-dropdown-menu .dropdown-item.logout-item:hover {
            background: #fef2f2;
            color: #dc2626;
        }

        .user-dropdown-menu .dropdown-item.caja-open-item:hover {
            background: #fffbeb;
            color: #d97706;
        }

        .user-dropdown-menu .dropdown-divider {
            margin: 0.4rem 0;
            border-color: #f1f5f9;
        }

        /* ---- CONTENIDO PRINCIPAL ---- */
        .main-container {
            flex: 1;
            margin: 2.25rem auto 3rem;
            padding: 0 1.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
            max-width: 1240px;
        }

        /* Botón Crear Destacado (Gradiente del Login) */
        .create-btn-wrapper {
            margin-bottom: 2.25rem;
        }

        .create-btn {
            background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-blue-dark) 100%);
            border: none;
            color: #ffffff !important;
            font-weight: 700;
            padding: 0.85rem 2.25rem;
            border-radius: 50px;
            font-size: 1.15rem;
            letter-spacing: -0.3px;
            box-shadow: 0 6px 18px rgba(0, 151, 204, 0.35);
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.65rem;
            cursor: pointer;
            text-decoration: none;
        }

        .create-btn:hover {
            background: linear-gradient(135deg, var(--color-blue-dark) 0%, #00608c 100%);
            transform: translateY(-3px);
            box-shadow: 0 10px 24px rgba(0, 151, 204, 0.45);
        }

        /* ---- CUADRÍCULA DE BOTONES GRANDES (El diseño original mejorado) ---- */
        .button-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 1.5rem;
            width: 100%;
        }

        .btn-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 165px;
            padding: 1.75rem 1.25rem;
            border: 1px solid var(--card-border);
            border-top: 5px solid var(--btn-accent, var(--color-blue));
            border-radius: 18px;
            color: var(--text-dark);
            background: #ffffff;
            text-decoration: none;
            box-shadow: 0 6px 20px rgba(16, 24, 40, 0.06);
            transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
            position: relative;
            cursor: pointer;
        }

        .btn-card:hover {
            transform: translateY(-5px);
            color: var(--text-dark);
            box-shadow: 0 14px 30px rgba(16, 24, 40, 0.12);
            border-color: #cbd5e1;
            border-top-color: var(--btn-accent, var(--color-blue));
        }

        /* Icono Grande Central */
        .btn-card i {
            font-size: 3.25rem;
            color: var(--btn-accent, var(--color-blue));
            margin-bottom: 0.85rem;
            line-height: 1;
            transition: transform 0.22s ease;
        }

        .btn-card:hover i {
            transform: scale(1.1);
        }

        /* Nombre del Módulo */
        .btn-card span {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text-dark);
            text-align: center;
            letter-spacing: -0.3px;
            line-height: 1.25;
            transition: color 0.2s ease;
        }

        .btn-card:hover span {
            color: var(--btn-accent, var(--color-blue));
        }

        /* Asignación de Colores Inspirada en Login y el Menú Original */
        .card-blue {
            --btn-accent: var(--color-blue);
        }

        .card-orange {
            --btn-accent: var(--color-orange);
        }

        .card-green {
            --btn-accent: var(--color-green);
        }

        /* ---- BARRA INFERIOR FIJA ---- */
        .bottom-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: var(--color-navy);
            color: #ffffff;
            padding: 0.9rem 2.25rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 500;
            font-size: 0.92rem;
            z-index: 1000;
            box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.12);
        }

        .bottom-brand {
            color: #94a3b8;
        }

        .bottom-brand strong {
            color: #ffffff;
        }

        .bottom-brand span {
            color: var(--color-orange);
        }

        .bottom-clock {
            font-variant-numeric: tabular-nums;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: #cbd5e1;
            font-weight: 600;
        }

        /* ---- MODALES LIMPIOS Y REDONDEADOS ---- */
        .modal-clean .modal-content {
            border: none;
            border-radius: 18px;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.2);
            overflow: hidden;
        }

        .modal-clean .modal-header {
            background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-blue-dark) 100%);
            color: #ffffff;
            padding: 1.25rem 1.5rem;
            border-bottom: none;
        }

        .modal-clean .modal-header.header-orange {
            background: linear-gradient(135deg, var(--color-orange) 0%, var(--color-orange-dark) 100%);
        }

        .modal-clean .modal-title {
            font-weight: 700;
            font-size: 1.25rem;
        }

        .modal-clean .btn-close {
            filter: brightness(0) invert(1);
        }

        .modal-clean .modal-body {
            padding: 1.75rem 1.5rem;
            background: #ffffff;
        }

        .modal-tile-btn {
            display: flex;
            align-items: center;
            gap: 1rem;
            width: 100%;
            padding: 1.1rem 1.25rem;
            border: 1.5px solid #e2e8f0;
            border-radius: 14px;
            background: #ffffff;
            color: var(--text-dark);
            text-decoration: none;
            font-size: 1.05rem;
            font-weight: 700;
            margin-bottom: 0.85rem;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .modal-tile-btn:hover {
            border-color: var(--color-blue);
            background: #f0f9ff;
            color: var(--color-blue-dark);
            transform: translateX(4px);
        }

        .modal-tile-btn i {
            font-size: 1.5rem;
            color: var(--color-blue);
            width: 32px;
            text-align: center;
        }

        @@media (max-width: 650px) {
            .top-bar {
                flex-direction: column;
                align-items: stretch;
                text-align: center;
                gap: 0.75rem;
            }
            .brand-link {
                justify-content: center;
            }
            .top-right {
                justify-content: center;
            }
            .button-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 0.85rem;
            }
            .btn-card {
                min-height: 135px;
                padding: 1.25rem 0.75rem;
            }
            .btn-card i {
                font-size: 2.5rem;
            }
            .btn-card span {
                font-size: 0.98rem;
            }
            .bottom-bar {
                padding: 0.75rem 1rem;
                font-size: 0.82rem;
            }
        }
    </style>
}

<!-- TOP BAR FIJA -->
<header class="top-bar">
    <div class="d-flex align-items-center gap-3">
        <a class="brand-link" asp-controller="Menu" asp-action="Menu">
            <span class="brand-icon"><i class="bi bi-wrench-adjustable-circle-fill"></i></span>
            <span class="brand-title">Taller<span>+</span></span>
        </a>
    </div>

    <div class="top-right">
        <!-- Estado de Caja -->
        <span class="status-caja-pill @(cajaAbierta ? "abierta" : "cerrada")">
            <span class="status-dot"></span>
            @(cajaAbierta ? "Caja Abierta" : "Caja Cerrada")
        </span>

        <!-- Menú Desplegable al presionar el Usuario -->
        <div class="dropdown">
            <button class="user-dropdown-btn dropdown-toggle" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle"></i>
                <span>@usuario</span>
                <span class="user-role-tag">@rol</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu" aria-labelledby="userMenuDropdown">
                <li class="user-dropdown-header">
                    <div class="user-header-name">@usuario</div>
                    <div class="user-header-role">@rol</div>
                </li>

                @if (User.IsInRole("Administrador") || User.IsInRole("Supervisor") || User.IsInRole("Cajero"))
                {
                    <li>
                        <form asp-controller="CajaDiaria" asp-action="@(cajaAbierta ? "CerrarCaja" : "AbrirCaja")" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item @(cajaAbierta ? "caja-close-item text-danger" : "caja-open-item text-warning")">
                                <i class="bi @(cajaAbierta ? "bi-lock-fill text-danger" : "bi-unlock-fill text-warning") me-2"></i>
                                <span>@(cajaAbierta ? "Cerrar Caja" : "Abrir Caja")</span>
                            </button>
                        </form>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                }

                <li>
                    <form asp-controller="Menu" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="dropdown-item logout-item text-danger">
                            <i class="bi bi-box-arrow-right me-2"></i>
                            <span>Cerrar Sesión</span>
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</header>

<!-- CONTENIDO PRINCIPAL -->
<main class="main-container">

    <!-- Mensaje Flash -->
    @if (TempData["SuccessMessage"] is string mensaje)
    {
        <div class="w-100 mb-3" style="max-width: 1200px;">
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@mensaje
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        </div>
    }

    <!-- BOTÓN DESTACADO: CREAR REGISTRO -->
    <div class="create-btn-wrapper">
        <button type="button" class="create-btn" data-bs-toggle="modal" data-bs-target="#modalCrearRapido">
            <i class="bi bi-plus-circle-fill fs-5"></i>
            <span>Crear Registro</span>
        </button>
    </div>

    <!-- CUADRÍCULA DE BOTONES GRANDES (Icono + Nombre con Colores del Login y Borde Superior) -->
    <div class="button-grid">

        <!-- 1. Órdenes de Trabajo (Azul) -->
        <a asp-controller="Menu" asp-action="Orden" class="btn-card card-blue">
            <i class="bi bi-clipboard2-check-fill"></i>
            <span>Órdenes de Trabajo</span>
        </a>

        <!-- 2. Presupuestos (Naranja) -->
        <a asp-controller="Menu" asp-action="Presupuesto" class="btn-card card-orange">
            <i class="bi bi-receipt"></i>
            <span>Presupuestos</span>
        </a>

        <!-- 3. Clientes (Azul) -->
        <a asp-controller="Menu" asp-action="Clientes" class="btn-card card-blue">
            <i class="bi bi-people-fill"></i>
            <span>Clientes</span>
        </a>

        <!-- 4. Vehículos (Naranja) -->
        <a asp-controller="Menu" asp-action="Vehiculos" class="btn-card card-orange">
            <i class="bi bi-car-front-fill"></i>
            <span>Vehículos</span>
        </a>

        <!-- 5. Inventario / Repuestos (Azul) -->
        <a asp-controller="Menu" asp-action="Productos" class="btn-card card-blue">
            <i class="bi bi-box-seam-fill"></i>
            <span>Inventario</span>
        </a>

        <!-- 6. Servicios de Mano de Obra (Naranja) -->
        <a asp-controller="Menu" asp-action="Servicios" class="btn-card card-orange">
            <i class="bi bi-tools"></i>
            <span>Servicios</span>
        </a>

        <!-- 7. Packs de Reparación (Azul) -->
        <a asp-controller="Menu" asp-action="Packs" class="btn-card card-blue">
            <i class="bi bi-boxes"></i>
            <span>Packs</span>
        </a>

        <!-- 8. Caja Diaria (Verde) -->
        @if (User.IsInRole("Administrador") || User.IsInRole("Supervisor") || User.IsInRole("Cajero"))
        {
            <a asp-controller="Menu" asp-action="CajaDiaria" class="btn-card card-green">
                <i class="bi bi-cash-stack"></i>
                <span>Caja Diaria</span>
            </a>
        }

        <!-- 9. Finanzas / Reportes (Naranja) -->
        @if (User.IsInRole("Administrador") || User.IsInRole("Supervisor"))
        {
            <a asp-controller="Menu" asp-action="Administracion" class="btn-card card-orange">
                <i class="bi bi-graph-up-arrow"></i>
                <span>Finanzas</span>
            </a>
        }

        <!-- 10. Personal / Empleados (Azul) -->
        @if (User.IsInRole("Administrador"))
        {
            <a asp-controller="Menu" asp-action="Empleados" class="btn-card card-blue">
                <i class="bi bi-person-badge-fill"></i>
                <span>Personal</span>
            </a>

            <!-- 11. Proveedores (Naranja) -->
            <a asp-controller="Menu" asp-action="Proveedores" class="btn-card card-orange">
                <i class="bi bi-truck"></i>
                <span>Proveedores</span>
            </a>
        }

    </div>

</main>

<!-- BOTTOM BAR FIJA (Del diseño original) -->
<footer class="bottom-bar">
    <div class="bottom-brand">
        <i class="bi bi-person-circle me-1"></i>Conectado: <strong>@usuario</strong> &nbsp;&middot;&nbsp; Taller<span>+</span>
    </div>
    <div class="bottom-clock">
        <i class="bi bi-clock me-1"></i>
        <span id="liveClockDisplay">--:--:--</span>
    </div>
</footer>

<!-- MODAL PASO 1: SELECCIONAR TIPO DE REGISTRO -->
<div class="modal fade modal-clean" id="modalCrearRapido" tabindex="-1" aria-labelledby="modalCrearRapidoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalCrearRapidoLabel">
                    <i class="bi bi-plus-circle-fill me-2"></i>¿Qué deseas crear?
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">Selecciona una opción para continuar:</p>
                <button type="button" class="modal-tile-btn" id="btnOptOrden">
                    <i class="bi bi-clipboard2-check"></i>
                    <span>Orden de Trabajo</span>
                </button>
                <button type="button" class="modal-tile-btn" id="btnOptPresupuesto">
                    <i class="bi bi-receipt" style="color: var(--color-orange);"></i>
                    <span>Presupuesto</span>
                </button>
                <a asp-controller="Cliente" asp-action="Crear" class="modal-tile-btn">
                    <i class="bi bi-person-plus"></i>
                    <span>Nuevo Cliente</span>
                </a>
                <a asp-controller="Vehiculo" asp-action="SeleccionarCliente" class="modal-tile-btn">
                    <i class="bi bi-car-front" style="color: var(--color-orange);"></i>
                    <span>Nuevo Vehículo</span>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PASO 2: ORDEN -->
<div class="modal fade modal-clean" id="modalPasoOrden" tabindex="-1" aria-labelledby="modalPasoOrdenLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalPasoOrdenLabel">
                    <i class="bi bi-clipboard2-check me-2"></i>Nueva Orden: Cliente
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">Indica si el propietario ya está registrado:</p>
                <a asp-controller="Orden" asp-action="SeleccionarClienteOrden" class="modal-tile-btn">
                    <i class="bi bi-search"></i>
                    <span>Seleccionar Cliente Existente</span>
                </a>
                <a asp-controller="Cliente" asp-action="Crear" asp-route-redirigirA="Orden" class="modal-tile-btn">
                    <i class="bi bi-person-plus" style="color: var(--color-green);"></i>
                    <span>Registrar Nuevo Cliente</span>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- MODAL PASO 2: PRESUPUESTO -->
<div class="modal fade modal-clean" id="modalPasoPresupuesto" tabindex="-1" aria-labelledby="modalPasoPresupuestoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header header-orange">
                <h5 class="modal-title" id="modalPasoPresupuestoLabel">
                    <i class="bi bi-receipt me-2"></i>Nuevo Presupuesto: Cliente
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">Indica si el propietario ya está registrado:</p>
                <a asp-controller="Presupuesto" asp-action="SeleccionarClientePresupuesto" class="modal-tile-btn">
                    <i class="bi bi-search" style="color: var(--color-orange);"></i>
                    <span>Seleccionar Cliente Existente</span>
                </a>
                <a asp-controller="Cliente" asp-action="Crear" asp-route-redirigirA="Presupuesto" class="modal-tile-btn">
                    <i class="bi bi-person-plus" style="color: var(--color-green);"></i>
                    <span>Registrar Nuevo Cliente</span>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Actualización de reloj en tiempo real
        function updateClock() {
            const now = new Date();
            const opts = {
                day: '2-digit', month: '2-digit', year: 'numeric',
                hour: '2-digit', minute: '2-digit', second: '2-digit'
            };
            const el = document.getElementById('liveClockDisplay');
            if (el) el.textContent = now.toLocaleString('es-NI', opts);
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Control de modales
        document.addEventListener('DOMContentLoaded', function () {
            const elCrear = document.getElementById('modalCrearRapido');
            const elOrd = document.getElementById('modalPasoOrden');
            const elPre = document.getElementById('modalPasoPresupuesto');

            if (typeof bootstrap !== 'undefined' && elCrear && elOrd && elPre) {
                const modalCrear = new bootstrap.Modal(elCrear);
                const modalPasoOrd = new bootstrap.Modal(elOrd);
                const modalPasoPre = new bootstrap.Modal(elPre);

                document.getElementById('btnOptOrden')?.addEventListener('click', () => {
                    modalCrear.hide();
                    modalPasoOrd.show();
                });

                document.getElementById('btnOptPresupuesto')?.addEventListener('click', () => {
                    modalCrear.hide();
                    modalPasoPre.show();
                });
            }
        });
    </script>
}
